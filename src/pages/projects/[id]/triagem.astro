<script is:inline>
  // filter tab toggle
  (function () {
    document.querySelectorAll('.filter-group').forEach(function (grp) {
      var btns = grp.querySelectorAll('.filter-btn');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          btns.forEach(function (b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');
        });
      });
    });
  })();

  // sheet card selection via checkbox
  (function () {
    document.querySelectorAll('.sheet-card').forEach(function (card) {
      var cb = card.querySelector('input[type="checkbox"]');
      if (!cb) return;
      cb.addEventListener('change', function () {
        card.classList.toggle('is-selected', cb.checked);
      });
    });
  })();

  // Pretext reflow (no-op if not present)
  (async function () {
    if (document.fonts && document.fonts.ready) await document.fonts.ready;
    var PT = window.Pretext || window.pretext || globalThis.Pretext;
    if (!PT || !PT.prepare || !PT.layout) return;
    var els = document.querySelectorAll('.page-lead, .sheet-title, .sheet-subtitle, .md-card .doc-sub');
    var prepared = new Map();
    els.forEach(function (el) { prepared.set(el, PT.prepare(el.textContent || '', getComputedStyle(el).font)); });
    function relayout() {
      els.forEach(function (el) {
        var h = prepared.get(el); if (!h) return;
        var lh = parseFloat(getComputedStyle(el).lineHeight) || 18;
        var r = PT.layout(h, el.clientWidth || 200, lh);
        el.style.minHeight = r.height + 'px';
      });
    }
    new ResizeObserver(function () { relayout(); }).observe(document.body);
    relayout();
  })();
</script>
