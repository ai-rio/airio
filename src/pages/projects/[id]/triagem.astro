        <div class="thumb-stroke s1"></div>
        <div class="thumb-stroke s2"></div>
        <div class="thumb-stroke s3"></div>
        <div class="thumb-stroke s4"></div>
        <div class="thumb-stroke s5"></div>
        <div class="thumb-stroke s6"></div>
        <div class="thumb-overlay">
          <span class="thumb-sheet-num">PE-ELE-FRC · 01/12</span>
          <span class="thumb-status-dot" aria-label="confirmada"></span>
        </div>
        <span class="thumb-checkbox"><input type="checkbox" aria-label="Selecionar prancha" /></span>
      </div>
      <div class="sheet-meta">
        <span class="sheet-title">Planta de Força</span>
        <span class="sheet-subtitle">Térreo · Esc. 1:50</span>
        <div class="sheet-tags">
          <span class="sheet-tag auto">AUTO</span>
          <span class="sheet-tag">FRC</span>
          <span class="sheet-tag">TER</span>
        </div>
      </div>
    </article>

    <article class="sheet-card">
      <div class="thumb">
        <div class="thumb-stroke s1"></div><div class="thumb-stroke s2"></div><div class="thumb-stroke s3"></div><div class="thumb-stroke s4"></div><div class="thumb-stroke s5"></div>
        <div class="thumb-overlay">
          <span class="thumb-sheet-num">PE-ELE-FRC · 02/12</span>
          <span class="thumb-status-dot"></span>
        </div>
        <span class="thumb-checkbox"><input type="checkbox" aria-label="Selecionar prancha" /></span>
      </div>
      <div class="sheet-meta">
        <span class="sheet-title">Planta de Força</span>
        <span class="sheet-subtitle">1º Pavimento · Esc. 1:50</span>
        <div class="sheet-tags">
          <span class="sheet-tag auto">AUTO</span>
          <span class="sheet-tag">FRC</span>
          <span class="sheet-tag">P1</span>
        </div>
      </div>
    </article>

    <article class="sheet-card">
      <div class="thumb">
        <div class="thumb-stroke s1"></div><div class="thumb-stroke s2"></div><div class="thumb-stroke s3"></div><div class="thumb-stroke s4"></div><div class="thumb-stroke s5"></div><div class="thumb-stroke s6"></div>
        <div class="thumb-overlay">
          <span class="thumb-sheet-num">PE-ELE-FRC · 03/12</span>
          <span class="thumb-status-dot"></span>
        </div>
        <span class="thumb-checkbox"><input type="checkbox" aria-label="Selecionar prancha" /></span>
      </div>
      <div class="sheet-meta">
        <span class="sheet-title">Planta de Força</span>
        <span class="sheet-subtitle">2º Pavimento · Esc. 1:50</span>
        <div class="sheet-tags">
          <span class="sheet-tag auto">AUTO</span>
          <span class="sheet-tag">FRC</span>
          <span class="sheet-tag">P2</span>
        </div>
      </div>
    </article>

    <article class="sheet-card">
      <div class="thumb">
        <div class="thumb-stroke s1"></div><div class="thumb-stroke s2"></div><div class="thumb-stroke s3"></div><div class="thumb-stroke s4"></div>
        <div class="thumb-overlay">
          <span class="thumb-sheet-num">PE-ELE-ILU · 01/12</span>
