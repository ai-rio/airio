            <span class="row-num">{s.kindShort} · {s.filename}</span>
            <span class="row-title">{s.kindFull}</span>
            <span class="row-pavimento" data-row-pavimento>
              {s.scaleSet === 1 && s.scaleDenom != null ? `1:${s.scaleDenom} · escala ✓` : 'sem escala'}
