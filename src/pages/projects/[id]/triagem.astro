---
import ProjectLayout from '../../../layouts/ProjectLayout.astro';
const { id } = Astro.params;
---

<ProjectLayout
	title="airio · Triagem · PROJECT-A PE06"
	step={3}
	doneSteps={[1, 2]}
	projectName="PROJECT-A PE06"
	breadcrumbTail="Triagem"
	keymap={['⌘ + Enter · próximo', 'ESC · cancelar', '⌘ + A · selecionar todas', '1/2/3 · filtrar']}
	footerLeftText="Triagem salva automaticamente"
	contentMaxWidth={1280}
>

<style>
  /* ============ screen body ============ */
  .screen-body {
    width: 100%;
    padding-bottom: var(--space-12);
  }

  /* ============ page header ============ */
  .page-eyebrow {
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-2);
  }
  .page-title {
    font: 600 28px/36px var(--font-sans);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-2);
    color: var(--color-fg-primary);
  }
  .page-lead {
    font: 400 15px/22px var(--font-sans);
    color: var(--color-fg-secondary);
    margin: 0 0 var(--space-6);
    max-width: 70ch;
  }

  /* ============ scope strip ============ */
  .scope-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
  }
  .scope-stat {
    flex: 1 1 auto;
    min-width: 130px;
    display: grid;
    gap: var(--space-1);
    padding-right: var(--space-3);
    border-right: 1px solid var(--color-border-default);
  }
  .scope-stat:last-child { border-right: none; }
  .scope-stat .val {
    font: 600 22px/28px var(--font-sans);
    color: var(--color-fg-primary);
    font-variant-numeric: tabular-nums;
  }
  .scope-stat .lbl {
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
  }
  .scope-stat.is-warn .val { color: var(--color-warning); }
  .scope-stat.is-warn .lbl { color: var(--color-warning); }
  .scope-stat.is-ok .val { color: var(--color-success); }

  /* ============ toolbar ============ */
  .toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }
  .filter-group {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: 2px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
  }
  .filter-btn {
    background: transparent;
    border: none;
    padding: 5px 10px;
    font: 500 12px/16px var(--font-sans);
    color: var(--color-fg-secondary);
    cursor: pointer;
    border-radius: var(--radius-xs);
  }
  .filter-btn.is-active {
    background: var(--color-bg-elevated);
    color: var(--color-fg-primary);
    box-shadow: 0 0 0 1px var(--color-border-default);
  }
  .filter-btn .count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg-muted);
    margin-left: 4px;
  }
  .filter-btn.is-active .count { color: var(--color-fg-secondary); }
  .toolbar .spacer { flex: 1; }
  .toolbar .bulk-msg {
    font: 500 12px/16px var(--font-sans);
    color: var(--color-fg-secondary);
  }
  .toolbar .bulk-msg .ok { color: var(--color-success); font-weight: 600; }
  .toolbar .bulk-msg .warn { color: var(--color-warning); font-weight: 600; }

  /* ============ sheet grid ============ */
  /* 5 cards across at 1440 viewport (contentMaxWidth=1280, ~1157px inner).
     220px minmax + 16px gap rounded to 4 cols (off by ~7px); 210px keeps the
     5-col density of the baseline. */
  .sheet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .sheet-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    transition: border-color var(--motion-fast) var(--ease-default);
    display: flex;
    flex-direction: column;
  }
  .sheet-card:hover { border-color: var(--color-border-strong); }
  /* is-selected uses accent — legitimate active/selection state per DESIGN.md */
  .sheet-card.is-selected { border-color: var(--color-accent); box-shadow: 0 0 0 1px var(--color-accent); }
  .sheet-card.is-warn { border-color: var(--color-warning-soft-border); }
  .sheet-card.is-outside { opacity: 0.55; }

  /* ============ thumbnail ============ */
  .thumb {
    position: relative;
    aspect-ratio: 16 / 11;
    background:
      repeating-linear-gradient(0deg, rgba(10,10,10,0.04) 0 1px, transparent 1px 16px),
      repeating-linear-gradient(90deg, rgba(10,10,10,0.04) 0 1px, transparent 1px 16px),
      var(--color-bg-surface);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border-default);
  }
  .thumb-overlay {
    position: absolute;
    inset: 0;
    padding: 8px 10px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  .thumb-sheet-num {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.02em;
    color: var(--color-fg-secondary);
    background: rgba(255,255,255,0.85);
    padding: 2px 5px;
    border-radius: 2px;
  }
  .thumb-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 0 2px rgba(255,255,255,0.85);
  }
  .thumb-status-dot.is-warn { background: var(--color-warning); }
  .thumb-status-dot.is-outside { background: var(--color-fg-disabled); }
  .thumb-checkbox {
    position: absolute;
    bottom: 8px;
    left: 8px;
    width: 18px;
    height: 18px;
    background: rgba(255,255,255,0.9);
    border-radius: 2px;
    cursor: pointer;
  }
  .thumb-checkbox input {
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  /* fake drawing strokes to suggest a planta */
  .thumb-stroke {
    position: absolute;
    background: rgba(10,10,10,0.12);
  }
  .thumb-stroke.s1 { top: 22%; left: 12%; right: 12%; height: 1px; }
  .thumb-stroke.s2 { top: 22%; bottom: 22%; left: 12%; width: 1px; }
  .thumb-stroke.s3 { top: 22%; bottom: 22%; right: 12%; width: 1px; }
  .thumb-stroke.s4 { bottom: 22%; left: 12%; right: 12%; height: 1px; }
  .thumb-stroke.s5 { top: 22%; bottom: 22%; left: 42%; width: 1px; opacity: 0.6; }
  .thumb-stroke.s6 { top: 50%; left: 12%; right: 12%; height: 1px; opacity: 0.6; }

  /* ============ sheet meta ============ */
  .sheet-meta {
    padding: var(--space-3);
    display: grid;
    gap: 6px;
  }
  .sheet-title {
    font: 600 13px/18px var(--font-sans);
    color: var(--color-fg-primary);
    letter-spacing: -0.005em;
  }
  .sheet-subtitle {
    font: 400 12px/16px var(--font-sans);
    color: var(--color-fg-secondary);
  }
  .sheet-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 2px;
  }
  .sheet-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.02em;
    color: var(--color-fg-secondary);
    padding: 1px 6px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: 2px;
  }
  .sheet-tag.auto { color: var(--color-success); border-color: transparent; background: var(--color-success-soft-bg); }
  .sheet-tag.revisar { color: var(--color-warning); border-color: transparent; background: var(--color-warning-soft-bg); }
  .sheet-tag.fora { color: var(--color-fg-muted); }

  /* ============ MD card ============ */
  .md-card {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--color-info-soft-bg);
    border: 1px solid #bae6fd;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
    align-items: center;
  }
  .md-card .visual {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .md-card .doc-stack {
    width: 56px;
    height: 72px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: 3px;
    position: relative;
    box-shadow: 4px 4px 0 -1px var(--color-bg-elevated), 4px 4px 0 0 var(--color-border-default);
    flex-shrink: 0;
  }
  .md-card .doc-stack::before, .md-card .doc-stack::after {
    content: '';
    position: absolute;
    left: 8px;
    right: 8px;
    height: 1px;
    background: rgba(10,10,10,0.15);
  }
  .md-card .doc-stack::before { top: 14px; }
  .md-card .doc-stack::after { top: 22px; }
  .md-card .doc-label {
    font: 600 14px/20px var(--font-sans);
    color: var(--color-info);
  }
  .md-card .doc-sub {
    font: 400 12px/16px var(--font-mono);
    color: var(--color-fg-secondary);
    font-variant-numeric: tabular-nums;
  }
  .md-card .sections {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 4px;
  }
  .md-section-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.02em;
    padding: 3px 6px;
    background: var(--color-bg-elevated);
    border: 1px solid #bae6fd;
    border-radius: 2px;
    color: var(--color-fg-secondary);
    text-transform: uppercase;
  }
  .md-card .action {
    font: 500 12px/16px var(--font-sans);
    color: var(--color-info);
    text-decoration: none;
    white-space: nowrap;
  }

  /* ============ form actions ============ */
  .form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
  }
  .form-meta { font: 400 12px/16px var(--font-sans); color: var(--color-fg-muted); }
  .form-actions .btn-group { display: flex; gap: var(--space-2); }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font: 500 13px/18px var(--font-sans);
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition: background var(--motion-fast) var(--ease-default), border-color var(--motion-fast) var(--ease-default);
  }
  .btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .btn-primary { background: var(--color-accent); color: #ffffff; text-decoration: none; }
  .btn-primary:hover { background: var(--color-accent-hover); }
  .btn-ghost { background: transparent; color: var(--color-fg-secondary); text-decoration: none; }
  .btn-ghost:hover { background: var(--color-bg-surface); color: var(--color-fg-primary); }
  .btn-sm { padding: 5px 10px; font-size: 12px; }

  @media (max-width: 768px) {
    .page-title { font-size: 22px; line-height: 30px; }
    .scope-strip { flex-direction: column; }
    .scope-stat { border-right: none; border-bottom: 1px solid var(--color-border-default); padding-bottom: var(--space-2); }
    .scope-stat:last-child { border-bottom: none; }
    .md-card { grid-template-columns: 1fr; }
  }
</style>

<div class="screen-body">

  <div class="page-eyebrow">Etapa 3 de 8 · Triagem das pranchas</div>
  <h1 class="page-title">O que tem em cada prancha</h1>
  <p class="page-lead">O airio leu o título de cada prancha e adivinhou o que ela é (planta de força, planta de iluminação, SDAI, corte, detalhe…). Confere as <strong>6 pra revisar</strong> abaixo e segue.</p>

  <!-- scope strip -->
  <section class="scope-strip" aria-label="Escopo do projeto">
    <div class="scope-stat is-ok">
      <span class="val">4 255 m²</span>
      <span class="lbl">Área total (MD)</span>
    </div>
    <div class="scope-stat">
      <span class="val">47</span>
      <span class="lbl">Pranchas</span>
    </div>
    <div class="scope-stat is-ok">
      <span class="val">41</span>
      <span class="lbl">Confirmadas (auto)</span>
    </div>
    <div class="scope-stat is-warn">
      <span class="val">6</span>
      <span class="lbl">Pra revisar</span>
    </div>
    <div class="scope-stat">
      <span class="val">3</span>
      <span class="lbl">Pavimentos</span>
    </div>
    <div class="scope-stat">
      <span class="val">7</span>
      <span class="lbl">Sistemas elétricos</span>
    </div>
  </section>

  <!-- toolbar -->
  <div class="toolbar" role="toolbar" aria-label="Filtros">
    <div class="filter-group">
      <button class="filter-btn is-active">Todas <span class="count">47</span></button>
      <button class="filter-btn">Confirmadas <span class="count">41</span></button>
      <button class="filter-btn">Pra revisar <span class="count">6</span></button>
      <button class="filter-btn">Fora de escopo <span class="count">8</span></button>
    </div>
    <div class="filter-group">
      <button class="filter-btn is-active">Por arquivo</button>
      <button class="filter-btn">Por pavimento</button>
      <button class="filter-btn">Por sistema</button>
    </div>
    <span class="spacer"></span>
    <span class="bulk-msg"><span class="ok">41 prontas</span> · <span class="warn">6 pra revisar</span></span>
    <button class="btn btn-ghost btn-sm">Confirmar todas as auto</button>
  </div>

  <!-- sheet grid -->
  <section class="sheet-grid" aria-label="Pranchas">

    <article class="sheet-card">
