---
// ScaleInspectModal — interactive PDF inspect overlay for S4 Escala.
//
// Opens over the page when user clicks the titleblock crop OR when auto-extract
// fails (scale_denom=null or 5xx). Lets the user verify what the carimbo says,
// pan around to find scale bars / level marks, and compare across the project's
// other sheets — WITHOUT flipping to Revu.
//
// Per [[project-visual-first-principle]] (architecture pick A=modal, B=re-render
// mupdf per zoom level, C=sidebar lists project sheets, D=single-page MVP,
// E=measurement tool deferred to HITL phase).
//
// Sheets list is rendered server-side from the same SheetView already loaded
// by preparacao/index.astro. Modal mutates the embedded PdfViewer's
// data-pdf-url + data-scale attrs and dispatches `pdfviewer:reload`.

import PdfViewer from './PdfViewer.astro';

interface SheetView {
	id: string;
	filename: string;
	pageIndex: number;
	kindShort: string;
}

const { projectId, sheets } = Astro.props as {
	projectId: string;
	sheets: SheetView[];
};

// Default initial sheet = first sheet. JS swaps on sidebar click / on open via
// `data-active-sheet-id` attr written by the page when modal opens.
const initial = sheets[0];
---

<div class="scale-modal" data-scale-modal data-project-id={projectId} hidden role="dialog" aria-modal="true" aria-label="Inspecionar prancha">
	<div class="scale-modal-backdrop" data-scale-modal-close></div>

	<div class="scale-modal-frame">
		<header class="scale-modal-head">
			<div class="scale-modal-title">
				<h2>Inspecionar prancha</h2>
				<span class="scale-modal-filename" data-scale-modal-filename>—</span>
			</div>
			<div class="scale-modal-zoom" role="group" aria-label="Zoom">
				<button type="button" class="zoom-btn" data-zoom-action="fit-page" title="Ajustar à página">⤢</button>
				<button type="button" class="zoom-btn" data-zoom-action="fit-width" title="Ajustar à largura">⇔</button>
				<span class="zoom-divider"></span>
				<button type="button" class="zoom-btn" data-zoom-action="out" title="Diminuir (Ctrl + rolagem)">−</button>
				<span class="zoom-readout" data-zoom-readout>100%</span>
				<button type="button" class="zoom-btn" data-zoom-action="in" title="Aumentar (Ctrl + rolagem)">+</button>
				<button type="button" class="zoom-btn" data-zoom-action="reset" title="Reset (1:1)">1×</button>
			</div>
			<button type="button" class="scale-modal-close" data-scale-modal-close aria-label="Fechar">×</button>
		</header>

		<div class="scale-modal-body">
			<aside class="scale-modal-sidebar" aria-label="Pranchas do projeto">
				<h3>Pranchas</h3>
				<ul>
					{sheets.map((s) => (
						<li>
							<button
								type="button"
								class="sheet-pick"
								data-sheet-pick
								data-sheet-id={s.id}
								data-sheet-filename={s.filename}
								data-sheet-page={s.pageIndex}
							>
								<span class="kind">{s.kindShort}</span>
								<span class="name">{s.filename}</span>
								<span class="page">p.{s.pageIndex + 1}</span>
							</button>
						</li>
					))}
				</ul>
			</aside>

			<div class="scale-modal-viewport" data-scale-modal-viewport>
				<div class="scale-modal-stage" data-scale-modal-stage>
					{initial && (
						<PdfViewer
							pdfUrl={`/api/projects/${projectId}/sheets/${initial.id}/pdf`}
							pageIndex={initial.pageIndex}
							mode="full"
							scale={2.5}
							class="scale-modal-pdf"
							ariaLabel="Prancha em zoom"
						/>
					)}
				</div>
			</div>
		</div>

		<footer class="scale-modal-foot">
			<p class="hint">Veja o carimbo, a barra de escala ou as cotas para descobrir o denominador (1:N). Depois feche e use <strong>Definir manualmente</strong>.</p>
		</footer>
	</div>
</div>

<style>
	.scale-modal {
		position: fixed;
		inset: 0;
		z-index: 1000;
		display: flex;
		align-items: stretch;
		justify-content: stretch;
	}
	.scale-modal[hidden] { display: none; }

	.scale-modal-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.55);
		cursor: zoom-out;
	}
	.scale-modal-frame {
		position: relative;
		margin: var(--space-4, 16px);
		flex: 1;
		display: flex;
		flex-direction: column;
		background: var(--color-bg-elevated, #fff);
		border: 1px solid var(--color-border-default, #d4d4d4);
		max-width: calc(100vw - 32px);
		max-height: calc(100vh - 32px);
		overflow: hidden;
	}
	.scale-modal-head {
		display: grid;
		grid-template-columns: 1fr auto auto;
		gap: var(--space-3, 12px);
		align-items: center;
		padding: var(--space-3, 12px) var(--space-4, 16px);
		border-bottom: 1px solid var(--color-border-default, #d4d4d4);
		background: var(--color-bg-surface, #fafaf9);
	}
	.scale-modal-title { display: flex; align-items: baseline; gap: var(--space-3, 12px); min-width: 0; }
	.scale-modal-title h2 {
		margin: 0;
		font: 600 16px/1.2 var(--font-sans, system-ui, sans-serif);
		color: var(--color-fg-primary, #1a1a1a);
	}
	.scale-modal-filename {
		font: 400 13px/1.2 var(--font-mono, ui-monospace, monospace);
		color: var(--color-fg-secondary, #525252);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.scale-modal-zoom {
		display: inline-flex;
		gap: 2px;
		background: var(--color-bg-canvas, #f5f5f4);
		padding: 2px;
		border: 1px solid var(--color-border-default, #d4d4d4);
	}
	.zoom-btn {
		font: 400 12px/1.2 var(--font-mono, ui-monospace, monospace);
		padding: 6px 10px;
		background: transparent;
		border: 0;
		color: var(--color-fg-secondary, #525252);
		cursor: pointer;
	}
	.zoom-btn:hover { background: var(--color-bg-elevated, #fff); }
	.zoom-btn.is-active {
		background: var(--color-bg-elevated, #fff);
		color: var(--color-fg-primary, #1a1a1a);
		font-weight: 600;
	}
	.zoom-divider {
		width: 1px;
		background: var(--color-border-default, #d4d4d4);
		margin: 2px 4px;
	}
	.zoom-readout {
		font: 400 12px/1 var(--font-mono, ui-monospace, monospace);
		color: var(--color-fg-primary, #1a1a1a);
		padding: 0 8px;
		min-width: 48px;
		text-align: center;
		display: inline-flex;
		align-items: center;
	}
	.scale-modal-close {
		font: 400 24px/1 var(--font-sans, system-ui, sans-serif);
		padding: 4px 12px;
		background: transparent;
		border: 1px solid transparent;
		color: var(--color-fg-secondary, #525252);
		cursor: pointer;
	}
	.scale-modal-close:hover {
		border-color: var(--color-border-default, #d4d4d4);
	}
	.scale-modal-body {
		flex: 1;
		display: grid;
		grid-template-columns: 220px 1fr;
		min-height: 0;
		overflow: hidden;
	}
	.scale-modal-sidebar {
		border-right: 1px solid var(--color-border-default, #d4d4d4);
		background: var(--color-bg-surface, #fafaf9);
		overflow-y: auto;
		padding: var(--space-3, 12px);
	}
	.scale-modal-sidebar h3 {
		margin: 0 0 var(--space-2, 8px);
		font: 600 11px/1.2 var(--font-mono, ui-monospace, monospace);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-fg-secondary, #525252);
	}
	.scale-modal-sidebar ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.sheet-pick {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 8px;
		align-items: baseline;
		width: 100%;
		padding: 8px;
		background: transparent;
		border: 1px solid transparent;
		text-align: left;
		font: 400 12px/1.3 var(--font-sans, system-ui, sans-serif);
		cursor: pointer;
		color: var(--color-fg-primary, #1a1a1a);
	}
	.sheet-pick:hover { background: var(--color-bg-elevated, #fff); }
	.sheet-pick.is-active {
		background: var(--color-bg-elevated, #fff);
		border-color: var(--color-accent, #ea580c);
	}
	.sheet-pick .kind {
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 11px;
		color: var(--color-fg-secondary, #525252);
	}
	.sheet-pick .name {
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 11px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.sheet-pick .page {
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 10px;
		color: var(--color-fg-muted, #737373);
	}
	.scale-modal-viewport {
		overflow: hidden;
		background: var(--color-bg-canvas, #f5f5f4);
		position: relative;
		touch-action: none;
		cursor: grab;
	}
	.scale-modal-viewport.is-panning { cursor: grabbing; }
	.scale-modal-stage {
		position: absolute;
		top: 0;
		left: 0;
		transform-origin: 0 0;
		will-change: transform;
	}
	.scale-modal-pdf {
		max-width: none;
		width: auto;
		background: #fff;
		border: 1px solid var(--color-border-default, #d4d4d4);
	}
	/* Override the default PdfViewer CSS so the rendered <img> keeps its
	   natural pixel size inside the stage. The stage's CSS transform then
	   scales the whole composite freely without the img being shrunk by
	   width:100% of a position:absolute parent (which collapses to 0).
	   :global() bypasses Astro's component-scoped CSS — PdfViewer's class
	   names live under its own astro-cid, ours under ours; without :global
	   the selectors miss. */
	.scale-modal-stage :global(.pdf-viewer) {
		position: static;
		width: auto;
		min-height: 0;
		border: 0;
		display: inline-block;
		background: transparent;
	}
	.scale-modal-stage :global(.pdf-img) {
		width: auto;
		max-width: none;
		height: auto;
		display: block;
	}
	.scale-modal-stage :global(.pdf-skeleton),
	.scale-modal-stage :global(.pdf-error) {
		position: static;
		padding: 24px;
	}
	.scale-modal-foot {
		padding: var(--space-3, 12px) var(--space-4, 16px);
		border-top: 1px solid var(--color-border-default, #d4d4d4);
		background: var(--color-bg-surface, #fafaf9);
	}
	.scale-modal-foot .hint {
		margin: 0;
		font: 400 13px/1.4 var(--font-sans, system-ui, sans-serif);
		color: var(--color-fg-secondary, #525252);
	}

	@media (max-width: 800px) {
		.scale-modal-body { grid-template-columns: 1fr; }
		.scale-modal-sidebar { display: none; }
	}
</style>

<script>
	(() => {
		const root = document.querySelector<HTMLElement>('[data-scale-modal]');
		if (!root) return;
		const modal: HTMLElement = root;

		const viewer = modal.querySelector<HTMLElement>('.pdf-viewer');
		const viewport = modal.querySelector<HTMLElement>('[data-scale-modal-viewport]');
		const stage = modal.querySelector<HTMLElement>('[data-scale-modal-stage]');
		const filenameEl = modal.querySelector<HTMLElement>('[data-scale-modal-filename]');
		const zoomReadout = modal.querySelector<HTMLElement>('[data-zoom-readout]');
		const sheetBtns = modal.querySelectorAll<HTMLButtonElement>('[data-sheet-pick]');

		// Close handlers — backdrop + close button.
		modal.querySelectorAll<HTMLElement>('[data-scale-modal-close]').forEach((el) => {
			el.addEventListener('click', () => close());
		});

		// Escape closes.
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !modal.hidden) close();
		});

		// ----- Continuous pan + zoom via CSS transform on the stage. -----
		// mupdf renders at fixed scale=2.5 (sharp). Interaction = transform only.
		// User-facing zoom = 1.0 means "fit-to-page" (entire planta visible).
		// Internal transform scale gets recomputed from user zoom + base fit ratio.
		let userZoom = 1; // 1 == fit-to-page
		let tx = 0;
		let ty = 0;
		let baseFit = 1; // scale at which the rendered PNG fits inside the viewport
		const MIN_ZOOM = 0.25;
		const MAX_ZOOM = 8;

		function getStageNaturalSize(): { w: number; h: number } {
			const img = stage?.querySelector<HTMLImageElement>('.pdf-img');
			if (!img || !img.complete || !img.naturalWidth) return { w: 0, h: 0 };
			return { w: img.naturalWidth, h: img.naturalHeight };
		}

		function recomputeBaseFit(): void {
			if (!viewport) return;
			const { w, h } = getStageNaturalSize();
			if (!w || !h) return;
			const fitW = viewport.clientWidth / w;
			const fitH = viewport.clientHeight / h;
			baseFit = Math.min(fitW, fitH);
		}

		function applyTransform(): void {
			if (!stage) return;
			const s = baseFit * userZoom;
			stage.style.transform = `translate(${tx}px, ${ty}px) scale(${s})`;
			if (zoomReadout) zoomReadout.textContent = Math.round(userZoom * 100) + '%';
		}

		function fitPage(): void {
			recomputeBaseFit();
			const { w, h } = getStageNaturalSize();
			if (!viewport || !w || !h) return;
			userZoom = 1;
			// Center inside viewport.
			tx = (viewport.clientWidth - w * baseFit) / 2;
			ty = (viewport.clientHeight - h * baseFit) / 2;
			applyTransform();
		}

		function fitWidth(): void {
			if (!viewport) return;
			const { w, h } = getStageNaturalSize();
			if (!w || !h) return;
			recomputeBaseFit();
			userZoom = (viewport.clientWidth / w) / baseFit;
			tx = 0;
			ty = 0;
			applyTransform();
		}

		function resetOneToOne(): void {
			if (!viewport) return;
			const { w, h } = getStageNaturalSize();
			if (!w || !h) return;
			recomputeBaseFit();
			userZoom = 1 / baseFit; // raw pixels of the rendered PNG = 1:1
			tx = 0;
			ty = 0;
			applyTransform();
		}

		function zoomBy(factor: number, anchorClientX?: number, anchorClientY?: number): void {
			if (!viewport) return;
			const rect = viewport.getBoundingClientRect();
			const ax = anchorClientX != null ? anchorClientX - rect.left : rect.width / 2;
			const ay = anchorClientY != null ? anchorClientY - rect.top : rect.height / 2;

			const oldScale = baseFit * userZoom;
			const newZoom = Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, userZoom * factor));
			const newScale = baseFit * newZoom;
			if (newScale === oldScale) return;

			// Keep the content under the anchor at the same screen point:
			// stage coord under anchor before/after must match → adjust tx/ty.
			tx = ax - (ax - tx) * (newScale / oldScale);
			ty = ay - (ay - ty) * (newScale / oldScale);
			userZoom = newZoom;
			applyTransform();
		}

		// Toolbar buttons
		modal.querySelectorAll<HTMLButtonElement>('[data-zoom-action]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const a = btn.getAttribute('data-zoom-action') || '';
				if (a === 'in') zoomBy(1.25);
				else if (a === 'out') zoomBy(1 / 1.25);
				else if (a === 'fit-page') fitPage();
				else if (a === 'fit-width') fitWidth();
				else if (a === 'reset') resetOneToOne();
			});
		});

		// Ctrl/Cmd + wheel = zoom anchored at cursor. Trackpad pinch fires
		// Ctrl+wheel automatically on Chrome/Firefox.
		viewport?.addEventListener(
			'wheel',
			(e) => {
				if (!(e.ctrlKey || e.metaKey)) return;
				e.preventDefault();
				const factor = Math.exp(-e.deltaY * 0.002); // smooth continuous zoom
				zoomBy(factor, e.clientX, e.clientY);
			},
			{ passive: false },
		);

		// Drag to pan.
		let dragging = false;
		let dragStartX = 0;
		let dragStartY = 0;
		let dragOrigTx = 0;
		let dragOrigTy = 0;
		viewport?.addEventListener('pointerdown', (e) => {
			if (e.button !== 0) return;
			dragging = true;
			dragStartX = e.clientX;
			dragStartY = e.clientY;
			dragOrigTx = tx;
			dragOrigTy = ty;
			viewport.classList.add('is-panning');
			viewport.setPointerCapture(e.pointerId);
		});
		viewport?.addEventListener('pointermove', (e) => {
			if (!dragging) return;
			tx = dragOrigTx + (e.clientX - dragStartX);
			ty = dragOrigTy + (e.clientY - dragStartY);
			applyTransform();
		});
		const endDrag = (e: PointerEvent) => {
			if (!dragging) return;
			dragging = false;
			viewport?.classList.remove('is-panning');
			try {
				viewport?.releasePointerCapture(e.pointerId);
			} catch {}
		};
		viewport?.addEventListener('pointerup', endDrag);
		viewport?.addEventListener('pointercancel', endDrag);

		// Reset to fit-page whenever the PDF (re)renders. Listen for img load
		// events on the rendered PNG inside the stage.
		const stageObs = new MutationObserver(() => {
			const img = stage?.querySelector<HTMLImageElement>('.pdf-img');
			if (!img) return;
			img.addEventListener('load', fitPage, { once: true });
			if (img.complete && img.naturalWidth) fitPage();
		});
		if (stage) {
			stageObs.observe(stage, { childList: true, subtree: true, attributes: true, attributeFilter: ['src'] });
		}

		// Window resize: recompute baseFit so the user's logical zoom stays the
		// same fraction of the viewport, but don't clobber pan position.
		window.addEventListener('resize', () => {
			if (modal.hidden) return;
			recomputeBaseFit();
			applyTransform();
		});

		// Sidebar sheet picker — swap viewer source.
		sheetBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				sheetBtns.forEach((b) => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				const sheetId = btn.getAttribute('data-sheet-id') || '';
				const filename = btn.getAttribute('data-sheet-filename') || '';
				const pageIndex = btn.getAttribute('data-sheet-page') || '0';
				const projectId = modal.getAttribute('data-project-id') || '';
				if (viewer && projectId && sheetId) {
					viewer.setAttribute(
						'data-pdf-url',
						`/api/projects/${encodeURIComponent(projectId)}/sheets/${encodeURIComponent(sheetId)}/pdf`,
					);
					viewer.setAttribute('data-page-index', pageIndex);
					viewer.dispatchEvent(new CustomEvent('pdfviewer:reload'));
				}
				if (filenameEl) filenameEl.textContent = filename;
			});
		});

		function open(sheetId?: string, filename?: string): void {
			modal.hidden = false;
			document.body.style.overflow = 'hidden';
			// Mark requested sheet as active in sidebar and trigger its click handler
			// so the viewer swaps. Falls back to whatever was server-rendered.
			if (sheetId) {
				const match = modal.querySelector<HTMLButtonElement>(`[data-sheet-pick][data-sheet-id="${CSS.escape(sheetId)}"]`);
				if (match) {
					match.click();
				} else if (filename && filenameEl) {
					filenameEl.textContent = filename;
				}
			} else {
				// First sheet button if any.
				const first = modal.querySelector<HTMLButtonElement>('[data-sheet-pick]');
				if (first) {
					first.classList.add('is-active');
					if (filenameEl) filenameEl.textContent = first.getAttribute('data-sheet-filename') || '';
				}
			}
			// Defer fit-to-page until after the modal becomes visible AND the
			// rendered img has finished layout. Without this, viewport.clientWidth
			// reads 0 (modal was hidden during initial PdfViewer render) and the
			// transform scale collapses to ~0 → planta shows as a thumbnail.
			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					const img = stage?.querySelector<HTMLImageElement>('.pdf-img');
					if (img && img.complete && img.naturalWidth) {
						fitPage();
					} else if (img) {
						img.addEventListener('load', fitPage, { once: true });
					}
				});
			});
		}

		function close(): void {
			modal.hidden = true;
			document.body.style.overflow = '';
		}

		// Global API — page-level JS dispatches `scaleinspect:open` on document
		// with detail {sheetId, filename, pageIndex} to open the modal.
		document.addEventListener('scaleinspect:open', (e) => {
			const d = (e as CustomEvent).detail || {};
			open(d.sheetId, d.filename);
		});
		document.addEventListener('scaleinspect:close', () => close());
	})();
</script>
