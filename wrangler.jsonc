{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "airio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-05-26",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},

	// Service binding to the auxiliary Worker that owns the Python estimator Container.
	// Astro endpoints reach the container via env.ESTIMATOR.fetch(request). The auxiliary
	// Worker is configured separately at workers/estimator-container/wrangler.jsonc and
	// registered via astro.config.mjs `auxiliaryWorkers`.
	"services": [
		{ "binding": "ESTIMATOR", "service": "airio-estimator-container" }
	]
}