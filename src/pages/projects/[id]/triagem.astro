---
import ProjectLayout from '../../../layouts/ProjectLayout.astro';
import PdfViewer from '../../../components/PdfViewer.astro';
import { loadProject } from '../../../lib/projects';
import { getDb } from '../../../lib/db';
import { sheets } from '../../../../db/schema';
import { asc, eq } from 'drizzle-orm';

const { id } = Astro.params;
const projectId = String(id ?? '');
const project = await loadProject(projectId);

if (!project) {
	return new Response('Project not found', { status: 404 });
}

const db = getDb();
const sheetRows = await db
	.select()
	.from(sheets)
	.where(eq(sheets.projectId, projectId))
	.orderBy(asc(sheets.createdAt));

// Kind labels (Portuguese). Inline per CLAUDE.md §2 — single consumer right
// now. Extract to src/lib/labels.ts when S6 or S9 consumes the same map.
const KIND_LABEL: Record<string, { full: string; short: string }> = {
	planta_forca: { full: 'Planta de Força', short: 'FRC' },
	iluminacao: { full: 'Planta de Iluminação', short: 'ILU' },
	quadro: { full: 'Quadro de Cargas', short: 'QDC' },
	unifilar: { full: 'Diagrama Unifilar', short: 'UNI' },
};
const KIND_ORDER = ['planta_forca', 'iluminacao', 'quadro', 'unifilar'] as const;

const total = sheetRows.length;
const tagged = sheetRows.filter((s) => s.kind && !s.ignored).length;
const ignored = sheetRows.filter((s) => s.ignored === 1).length;
const pending = total - tagged - ignored;
const nextReady = total > 0 && pending === 0;
const projectName = project.name;
---

<ProjectLayout
	title={`airio · Triagem · ${projectName}`}
	step={3}
	doneSteps={[1, 2]}
	projectName={projectName}
	breadcrumbTail="Triagem"
	keymap={['⌘ + Enter · próximo', 'ESC · cancelar']}
	footerLeftText="Triagem salva automaticamente"
	contentMaxWidth={1280}
>

<style>
  .screen-body { width: 100%; padding-bottom: var(--space-12); }

  .page-eyebrow {
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-2);
  }
  .page-title {
    font: 600 28px/36px var(--font-sans);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-2);
    color: var(--color-fg-primary);
  }
  .page-lead {
    font: 400 15px/22px var(--font-sans);
    color: var(--color-fg-secondary);
    margin: 0 0 var(--space-6);
    max-width: 70ch;
  }

  /* scope strip — REAL counts only (no mocked area / pavimentos / sistemas) */
  .scope-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
  }
  .scope-stat {
    flex: 1 1 auto;
    min-width: 130px;
    display: grid;
    gap: var(--space-1);
    padding-right: var(--space-3);
    border-right: 1px solid var(--color-border-default);
  }
  .scope-stat:last-child { border-right: none; }
  .scope-stat .val {
    font: 600 22px/28px var(--font-sans);
    color: var(--color-fg-primary);
    font-variant-numeric: tabular-nums;
  }
  .scope-stat .lbl {
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
  }
  .scope-stat.is-warn .val { color: var(--color-warning); }
  .scope-stat.is-warn .lbl { color: var(--color-warning); }
  .scope-stat.is-ok .val { color: var(--color-success); }
  .scope-stat.is-muted .val { color: var(--color-fg-muted); }

  /* toolbar */
  .toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .filter-group {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: 2px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
  }
  .filter-btn {
    background: transparent;
    border: none;
    padding: 5px 10px;
    font: 500 12px/16px var(--font-sans);
    color: var(--color-fg-secondary);
    cursor: pointer;
    border-radius: var(--radius-xs);
  }
  .filter-btn.is-active {
    background: var(--color-bg-elevated);
    color: var(--color-fg-primary);
    box-shadow: 0 0 0 1px var(--color-border-default);
  }
  .filter-btn .count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg-muted);
    margin-left: 4px;
  }
  .filter-btn.is-active .count { color: var(--color-fg-secondary); }
  .toolbar .spacer { flex: 1; }
  .toolbar .bulk-msg {
    font: 500 12px/16px var(--font-sans);
    color: var(--color-fg-secondary);
  }
  .toolbar .bulk-msg .ok { color: var(--color-success); font-weight: 600; }
  .toolbar .bulk-msg .warn { color: var(--color-warning); font-weight: 600; }
  .toolbar .bulk-msg .muted { color: var(--color-fg-muted); }

  /* sheet grid */
  .sheet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .sheet-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color var(--motion-fast) var(--ease-default), opacity var(--motion-fast) var(--ease-default);
  }
  .sheet-card[data-state="ignored"] { opacity: 0.55; }
  .sheet-card[data-state="pending"] { border-color: var(--color-warning-soft-border); }

  /* PDF preview (visual-first principle — user sees the planta to classify) */
  .sheet-card .sheet-preview {
    border: none;
    border-bottom: 1px solid var(--color-border-subtle);
    aspect-ratio: 4 / 3;
    background: var(--color-bg-canvas, #f5f5f4);
  }
  .sheet-card[data-state="ignored"] .sheet-preview { filter: grayscale(0.6); }

  /* meta block */
  .sheet-meta {
    padding: var(--space-3) var(--space-4);
    display: grid;
    gap: 4px;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .sheet-filename {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg-primary);
    font-variant-numeric: tabular-nums;
    word-break: break-all;
  }
  .sheet-sub {
    font: 400 11px/14px var(--font-mono);
    color: var(--color-fg-muted);
    font-variant-numeric: tabular-nums;
  }
  .sheet-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 11px/14px var(--font-sans);
    margin-top: 2px;
  }
  .sheet-status .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-fg-disabled);
  }
  .sheet-status[data-state="tagged"] { color: var(--color-success); }
  .sheet-status[data-state="tagged"] .dot { background: var(--color-success); }
  .sheet-status[data-state="pending"] { color: var(--color-warning); }
  .sheet-status[data-state="pending"] .dot { background: var(--color-warning); }
  .sheet-status[data-state="ignored"] { color: var(--color-fg-muted); }
  .sheet-status[data-state="ignored"] .dot { background: var(--color-fg-muted); }

  /* tag buttons grid */
  .kind-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4px;
    padding: var(--space-3) var(--space-4);
  }
  .kind-btn {
    font: 500 12px/16px var(--font-sans);
    padding: 6px 8px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xs);
    color: var(--color-fg-secondary);
    cursor: pointer;
    transition: background var(--motion-fast) var(--ease-default), border-color var(--motion-fast) var(--ease-default), color var(--motion-fast) var(--ease-default);
    text-align: left;
  }
  .kind-btn:hover {
    background: var(--color-bg-elevated);
    border-color: var(--color-border-strong);
    color: var(--color-fg-primary);
  }
  /* is-active uses accent — legitimate active/selection state per DESIGN.md orange-discipline */
  .kind-btn.is-active {
    background: var(--color-accent-soft-bg);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .kind-btn:disabled {
    opacity: 0.5;
    cursor: progress;
  }
  .kind-btn .short {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-fg-muted);
    margin-left: 6px;
    letter-spacing: 0.02em;
  }
  .kind-btn.is-active .short { color: var(--color-accent); }

  .ignore-row {
    display: flex;
    justify-content: flex-end;
    padding: 0 var(--space-4) var(--space-3);
  }
  .ignore-btn {
    font: 500 11px/16px var(--font-sans);
    padding: 4px 8px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-xs);
    color: var(--color-fg-muted);
    cursor: pointer;
    transition: background var(--motion-fast) var(--ease-default), color var(--motion-fast) var(--ease-default);
  }
  .ignore-btn:hover {
    background: var(--color-bg-surface);
    color: var(--color-fg-secondary);
  }
  .ignore-btn.is-active {
    color: var(--color-warning);
    background: var(--color-warning-soft-bg);
    border-color: var(--color-warning-soft-border);
  }
  .ignore-btn:disabled { opacity: 0.5; cursor: progress; }

  /* row-level status banner */
  .row-status {
    font: 400 11px/14px var(--font-sans);
    color: var(--color-fg-muted);
    padding: 0 var(--space-4) var(--space-2);
    min-height: 14px;
  }
  .row-status.is-error { color: var(--color-danger); }

  /* empty state */
  .empty {
    padding: var(--space-8);
    text-align: center;
    background: var(--color-bg-surface);
    border: 1px dashed var(--color-border-default);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-8);
  }
  .empty h2 { font: 600 16px/22px var(--font-sans); margin: 0 0 var(--space-2); color: var(--color-fg-primary); }
  .empty p { font: 400 13px/18px var(--font-sans); color: var(--color-fg-secondary); margin: 0; }
  .empty a { color: var(--color-accent); text-decoration: none; font-weight: 500; }

  /* form actions */
  .form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
  }
  .form-meta { font: 400 12px/16px var(--font-sans); color: var(--color-fg-muted); }
  .form-actions .btn-group { display: flex; gap: var(--space-2); }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font: 500 13px/18px var(--font-sans);
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    text-decoration: none;
    transition: background var(--motion-fast) var(--ease-default), border-color var(--motion-fast) var(--ease-default);
  }
  .btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .btn-primary { background: var(--color-accent); color: #ffffff; }
  .btn-primary:hover { background: var(--color-accent-hover); }
  .btn-ghost { color: var(--color-fg-secondary); }
  .btn-ghost:hover { background: var(--color-bg-surface); color: var(--color-fg-primary); }
  .btn.is-disabled, .btn[aria-disabled="true"] {
    opacity: 0.5;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .page-title { font-size: 22px; line-height: 30px; }
    .scope-strip { flex-direction: column; }
    .scope-stat { border-right: none; border-bottom: 1px solid var(--color-border-default); padding-bottom: var(--space-2); }
    .scope-stat:last-child { border-bottom: none; }
    .kind-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="screen-body">

  <div class="page-eyebrow">Etapa 3 de 8 · Triagem das pranchas</div>
  <h1 class="page-title">O que tem em cada prancha</h1>
  <p class="page-lead">Para cada PDF enviado, classifique o tipo. <strong>Planta de Força</strong>, <strong>Iluminação</strong>, <strong>Quadro de Cargas</strong> ou <strong>Unifilar</strong>. Se não for elétrico (capa, arquitetura, índice), ignorar — não entra nos cálculos.</p>

  <section class="scope-strip" aria-label="Status da triagem">
    <div class="scope-stat">
      <span class="val">{total}</span>
      <span class="lbl">Pranchas</span>
    </div>
    <div class={`scope-stat ${tagged === total && total > 0 ? 'is-ok' : ''}`}>
      <span class="val">{tagged}</span>
      <span class="lbl">Classificadas</span>
    </div>
    <div class={`scope-stat ${pending > 0 ? 'is-warn' : ''}`}>
      <span class="val">{pending}</span>
      <span class="lbl">Pendentes</span>
    </div>
    <div class="scope-stat is-muted">
      <span class="val">{ignored}</span>
      <span class="lbl">Ignoradas</span>
    </div>
  </section>

  {total > 0 && (
    <div class="toolbar" role="toolbar" aria-label="Filtros">
      <div class="filter-group" data-filter-group>
        <button class="filter-btn is-active" data-filter="all">Todas <span class="count">{total}</span></button>
        <button class="filter-btn" data-filter="pending">Pendentes <span class="count">{pending}</span></button>
        <button class="filter-btn" data-filter="tagged">Classificadas <span class="count">{tagged}</span></button>
        <button class="filter-btn" data-filter="ignored">Ignoradas <span class="count">{ignored}</span></button>
      </div>
      <span class="spacer"></span>
      <span class="bulk-msg">
        {pending === 0 && total > 0
          ? <Fragment><span class="ok">Tudo classificado</span> · próximo desbloqueado</Fragment>
          : <Fragment><span class="warn">{pending} pendente{pending === 1 ? '' : 's'}</span> · <span class="muted">classifique para liberar próximo</span></Fragment>}
      </span>
    </div>
  )}

  {total === 0 ? (
    <div class="empty">
      <h2>Sem PDFs enviados</h2>
      <p>Volte para <a href={`/projects/${projectId}/documentos`}>Documentos</a> e envie ao menos um PDF.</p>
    </div>
  ) : (
    <section class="sheet-grid" aria-label="Pranchas" id="sheet-grid">
      {sheetRows.map((s) => {
        const state = s.ignored === 1 ? 'ignored' : s.kind ? 'tagged' : 'pending';
        return (
          <article class="sheet-card" data-sheet-id={s.id} data-state={state}>
            <PdfViewer
              pdfUrl={`/api/projects/${projectId}/sheets/${s.id}/pdf`}
              pageIndex={s.pageIndex ?? 0}
              mode="full"
              scale={1.0}
              class="sheet-preview"
              ariaLabel={`Pré-visualização de ${s.filename ?? 'prancha'}`}
            />
            <div class="sheet-meta">
              <span class="sheet-filename">{s.filename ?? '(sem nome)'}</span>
              <span class="sheet-sub">Pág. {String((s.pageIndex ?? 0) + 1).padStart(2, '0')} · {new Date(s.createdAt).toLocaleDateString('pt-BR')}</span>
              <span class="sheet-status" data-status data-state={state}>
                <span class="dot"></span>
                <span data-status-label>{
                  state === 'tagged' ? KIND_LABEL[s.kind!].full :
                  state === 'ignored' ? 'Ignorada' : 'Pendente'
                }</span>
              </span>
            </div>
            <div class="kind-grid" role="radiogroup" aria-label="Classificar tipo">
              {KIND_ORDER.map((k) => (
                <button
                  type="button"
                  class={`kind-btn ${s.kind === k && s.ignored !== 1 ? 'is-active' : ''}`}
                  data-kind={k}
                  aria-pressed={s.kind === k && s.ignored !== 1 ? 'true' : 'false'}
                >
                  {KIND_LABEL[k].full}<span class="short">{KIND_LABEL[k].short}</span>
                </button>
              ))}
            </div>
            <div class="ignore-row">
              <button
                type="button"
                class={`ignore-btn ${s.ignored === 1 ? 'is-active' : ''}`}
                data-ignore
                aria-pressed={s.ignored === 1 ? 'true' : 'false'}
              >{s.ignored === 1 ? 'Ignorada · desfazer' : 'Ignorar'}</button>
            </div>
            <p class="row-status" data-row-status></p>
          </article>
        );
      })}
    </section>
  )}

  <div class="form-actions">
    <span class="form-meta">{total === 0
      ? 'Envie PDFs em Documentos para começar'
      : pending === 0
        ? 'Triagem completa · pode seguir'
        : `${pending} prancha${pending === 1 ? '' : 's'} aguardando classificação`}</span>
    <div class="btn-group">
      <a class="btn btn-ghost" href={`/projects/${projectId}/documentos`}>← Documentos</a>
      <a
        class={nextReady ? 'btn btn-primary' : 'btn btn-primary is-disabled'}
        href={nextReady ? `/projects/${projectId}/preparacao` : '#'}
        aria-disabled={nextReady ? 'false' : 'true'}
      >Próximo · Preparação →</a>
    </div>
  </div>

</div>

</ProjectLayout>

<script is:inline define:vars={{ projectId }}>
  // S3 Triagem wire: click-to-tag / ignore → PATCH → optimistic update.
  // Per .claude/rules/dev-workflow.md §1: gate = curl smoke + audit_log row +
  // browser SSR re-render. Optimistic UI fine because data fits in client state
  // and the next page-load re-fetches from D1.
  (function () {
    const SESSION_KEY = 'airio.session';
    function getSessionId() {
      let id = localStorage.getItem(SESSION_KEY);
      if (!id) {
        id = 'sess_' + (crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).slice(2));
        localStorage.setItem(SESSION_KEY, id);
      }
      return id;
    }

    const KIND_LABEL = {
      planta_forca: 'Planta de Força',
      iluminacao: 'Planta de Iluminação',
      quadro: 'Quadro de Cargas',
      unifilar: 'Diagrama Unifilar',
    };

    async function patchSheet(sheetId, body) {
      const res = await fetch(
        `/api/projects/${encodeURIComponent(projectId)}/sheets/${encodeURIComponent(sheetId)}`,
        {
          method: 'PATCH',
          headers: {
            'content-type': 'application/json',
            'x-airio-session': getSessionId(),
          },
          body: JSON.stringify(body),
        },
      );
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.message || `HTTP ${res.status}`);
      return data.sheet;
    }

    function setRowStatus(card, msg, isError) {
      const el = card.querySelector('[data-row-status]');
      if (!el) return;
      el.textContent = msg || '';
      el.classList.toggle('is-error', !!isError);
    }

    function applySheetState(card, sheet) {
      const ignored = sheet.ignored === 1;
      const state = ignored ? 'ignored' : sheet.kind ? 'tagged' : 'pending';
      card.setAttribute('data-state', state);

      // status pill
      const statusEl = card.querySelector('[data-status]');
      const statusLbl = card.querySelector('[data-status-label]');
      if (statusEl) statusEl.setAttribute('data-state', state);
      if (statusLbl) {
        statusLbl.textContent = state === 'tagged' ? KIND_LABEL[sheet.kind] :
                                state === 'ignored' ? 'Ignorada' : 'Pendente';
      }

      // kind buttons
      card.querySelectorAll('.kind-btn').forEach((btn) => {
        const k = btn.getAttribute('data-kind');
        const active = !ignored && sheet.kind === k;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      // ignore button
      const ignBtn = card.querySelector('[data-ignore]');
      if (ignBtn) {
        ignBtn.classList.toggle('is-active', ignored);
        ignBtn.setAttribute('aria-pressed', ignored ? 'true' : 'false');
        ignBtn.textContent = ignored ? 'Ignorada · desfazer' : 'Ignorar';
      }
    }

    function recountScopeStrip() {
      const cards = document.querySelectorAll('.sheet-card');
      let total = 0, tagged = 0, pending = 0, ignored = 0;
      cards.forEach((c) => {
        total++;
        const s = c.getAttribute('data-state');
        if (s === 'tagged') tagged++;
        else if (s === 'ignored') ignored++;
        else pending++;
      });
      const stats = document.querySelectorAll('.scope-strip .scope-stat');
      if (stats.length >= 4) {
        stats[0].querySelector('.val').textContent = String(total);
        stats[1].querySelector('.val').textContent = String(tagged);
        stats[1].classList.toggle('is-ok', tagged === total && total > 0);
        stats[2].querySelector('.val').textContent = String(pending);
        stats[2].classList.toggle('is-warn', pending > 0);
        stats[3].querySelector('.val').textContent = String(ignored);
      }
      // toolbar counters
      const f = document.querySelector('[data-filter-group]');
      if (f) {
        const set = (sel, n) => { const el = f.querySelector(sel); if (el) el.textContent = String(n); };
        set('[data-filter="all"] .count', total);
        set('[data-filter="pending"] .count', pending);
        set('[data-filter="tagged"] .count', tagged);
        set('[data-filter="ignored"] .count', ignored);
      }
      // bulk message
      const bulk = document.querySelector('.toolbar .bulk-msg');
      if (bulk) {
        if (pending === 0 && total > 0) {
          bulk.innerHTML = '<span class="ok">Tudo classificado</span> · próximo desbloqueado';
        } else {
          bulk.innerHTML = `<span class="warn">${pending} pendente${pending === 1 ? '' : 's'}</span> · <span class="muted">classifique para liberar próximo</span>`;
        }
      }
      // next button
      const nextBtn = document.querySelector('.form-actions .btn-primary');
      const formMeta = document.querySelector('.form-meta');
      const ready = total > 0 && pending === 0;
      if (nextBtn) {
        nextBtn.classList.toggle('is-disabled', !ready);
        nextBtn.setAttribute('aria-disabled', ready ? 'false' : 'true');
        nextBtn.setAttribute('href', ready ? `/projects/${projectId}/preparacao` : '#');
      }
      if (formMeta) {
        formMeta.textContent = total === 0
          ? 'Envie PDFs em Documentos para começar'
          : ready
            ? 'Triagem completa · pode seguir'
            : `${pending} prancha${pending === 1 ? '' : 's'} aguardando classificação`;
      }
    }

    function lockButtons(card, lock) {
      card.querySelectorAll('button').forEach((b) => { b.disabled = lock; });
    }

    document.querySelectorAll('.sheet-card').forEach((card) => {
      const sheetId = card.getAttribute('data-sheet-id');
      if (!sheetId) return;

      // Kind buttons
      card.querySelectorAll('.kind-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const kind = btn.getAttribute('data-kind');
          const isActive = btn.classList.contains('is-active');
          // toggle off if clicking the active one → kind=null + ignored=0
          const body = isActive
            ? { kind: null, ignored: 0 }
            : { kind, ignored: 0 };
          setRowStatus(card, 'Salvando…');
          lockButtons(card, true);
          try {
            const sheet = await patchSheet(sheetId, body);
            applySheetState(card, sheet);
            recountScopeStrip();
            setRowStatus(card, '');
          } catch (err) {
            setRowStatus(card, 'Falhou ao salvar — ' + (err.message || 'erro'), true);
            console.error('[S3 patch]', err);
          } finally {
            lockButtons(card, false);
          }
        });
      });

      // Ignore button
      const ignBtn = card.querySelector('[data-ignore]');
      if (ignBtn) {
        ignBtn.addEventListener('click', async () => {
          const wasIgnored = ignBtn.classList.contains('is-active');
          const body = wasIgnored ? { ignored: 0 } : { ignored: 1, kind: null };
          setRowStatus(card, 'Salvando…');
          lockButtons(card, true);
          try {
            const sheet = await patchSheet(sheetId, body);
            applySheetState(card, sheet);
            recountScopeStrip();
            setRowStatus(card, '');
          } catch (err) {
            setRowStatus(card, 'Falhou ao salvar — ' + (err.message || 'erro'), true);
            console.error('[S3 patch]', err);
          } finally {
            lockButtons(card, false);
          }
        });
      }
    });

    // Filter tabs
    const filterGroup = document.querySelector('[data-filter-group]');
    if (filterGroup) {
      filterGroup.querySelectorAll('.filter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          filterGroup.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          const filter = btn.getAttribute('data-filter');
          document.querySelectorAll('.sheet-card').forEach((card) => {
            const s = card.getAttribute('data-state');
            const show = filter === 'all' ||
              (filter === 'pending' && s === 'pending') ||
              (filter === 'tagged' && s === 'tagged') ||
              (filter === 'ignored' && s === 'ignored');
            card.style.display = show ? '' : 'none';
          });
        });
      });
    }
  })();

  // Pretext reflow (no-op if not present)
  (async function () {
    if (document.fonts && document.fonts.ready) await document.fonts.ready;
    const PT = window.Pretext || window.pretext || globalThis.Pretext;
    if (!PT || !PT.prepare || !PT.layout) return;
    const els = document.querySelectorAll('.page-lead, .sheet-filename');
    const prepared = new Map();
    els.forEach((el) => { prepared.set(el, PT.prepare(el.textContent || '', getComputedStyle(el).font)); });
    function relayout() {
      els.forEach((el) => {
        const h = prepared.get(el); if (!h) return;
        const lh = parseFloat(getComputedStyle(el).lineHeight) || 18;
        const r = PT.layout(h, el.clientWidth || 200, lh);
        el.style.minHeight = r.height + 'px';
      });
    }
    new ResizeObserver(() => relayout()).observe(document.body);
    relayout();
  })();
</script>
