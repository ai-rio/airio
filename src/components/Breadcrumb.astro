---
type Segment = string | { label: string; href?: string | null };

interface Props {
	segments: Segment[];
}

const { segments } = Astro.props;

const normalized = segments.map((s) =>
	typeof s === 'string' ? { label: s, href: null } : { label: s.label, href: s.href ?? null }
);
const lastIdx = normalized.length - 1;
---

<nav class="breadcrumb-nav" aria-label="Onde estou">
	{normalized.map((seg, i) => (
		<>
			{i > 0 && <span class="sep">/</span>}
			{i === lastIdx ? (
				<span class="current" aria-current="page">{seg.label}</span>
			) : seg.href ? (
				<a class="link" href={seg.href}>{seg.label}</a>
			) : (
				<span>{seg.label}</span>
			)}
		</>
	))}
</nav>

<style>
	.breadcrumb-nav {
		font: 500 12px/1 var(--font-sans);
		color: var(--color-fg-secondary);
		letter-spacing: 0.01em;
	}
	.breadcrumb-nav .sep {
		color: var(--color-fg-disabled);
		margin: 0 var(--space-2);
	}
	.breadcrumb-nav .current {
		color: var(--color-fg-primary);
		font-weight: 600;
	}
	.breadcrumb-nav .link {
		color: inherit;
		text-decoration: none;
		cursor: pointer;
		transition: color var(--motion-fast) var(--ease-default);
	}
	.breadcrumb-nav .link:hover {
		color: var(--color-fg-primary);
	}
	.breadcrumb-nav .link:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
		border-radius: var(--radius-xs);
	}
</style>
