{
  "name": "airio",
  "private": true,
  "workspaces": ["site", "dashboard", "convex"],
  "scripts": {
    "dev": "concurrently --kill-others --names site,dashboard,convex --prefix-colors blue,yellow,green \"bun run dev:site\" \"bun run dev:dashboard\" \"bun run dev:convex\"",
    "dev:site": "cd site && bun run dev",
    "dev:dashboard": "cd dashboard && bun run dev",
    "dev:convex": "npx convex dev",
    "build": "cd dashboard && bun run build && cd ../site && bun run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && cd dashboard && tsc --noEmit && cd ../site && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "ln -sf ../convex node_modules/airio-convex 2>/dev/null; exit 0"
  },
  "dependencies": {
    "convex": "^1.17.0",
    "@anthropic-ai/sdk": "^0.52.0",
    "@auth/core": "^0.37.4",
    "@convex-dev/auth": "^0.0.80",
    "dodopayments": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "concurrently": "^9.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
