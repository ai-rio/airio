---
interface Props {
	name: string;
}

const { name } = Astro.props;

// Derive initials: take first letter of each word, max 2
const initials = name
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((w) => w[0].toUpperCase())
	.join('');
---

<div class="user-chip">
	<span>{name}</span>
	<span class="avatar" aria-hidden="true">{initials}</span>
</div>

<style>
	.user-chip {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font: 500 12px/1 var(--font-sans);
		color: var(--color-fg-secondary);
	}
	.avatar {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: var(--color-accent-soft-bg);
		color: var(--color-accent-soft-fg);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font: 600 11px/1 var(--font-sans);
		letter-spacing: 0.02em;
	}
</style>
