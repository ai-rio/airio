    <!-- needs review: titleblock unreadable -->
    <article class="sheet-card is-warn">
      <div class="thumb">
        <div class="thumb-stroke s1"></div><div class="thumb-stroke s4"></div>
        <div class="thumb-overlay">
          <span class="thumb-sheet-num">PE-ELE-FRC · 09/12</span>
          <span class="thumb-status-dot is-warn"></span>
        </div>
        <span class="thumb-checkbox"><input type="checkbox" aria-label="Selecionar prancha" /></span>
      </div>
      <div class="sheet-meta">
        <span class="sheet-title">Detalhe ou Corte?</span>
