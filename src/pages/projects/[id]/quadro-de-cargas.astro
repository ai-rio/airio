<script is:inline>
  // quadro list activation
  (function () {
    const rows = document.querySelectorAll('.quadro-row');
    rows.forEach(function (row) {
      row.addEventListener('click', function () {
        rows.forEach(function (r) { r.classList.remove('is-active'); });
        row.classList.add('is-active');
      });
    });
  })();

  // tipo-chip flip (alimentador ↔ interno — reserva stays reserva)
  (function () {
    document.querySelectorAll('.tipo-chip:not(.is-reserva)').forEach(function (chip) {
      chip.addEventListener('click', function (e) {
        e.stopPropagation();
        if (chip.classList.contains('is-alim')) {
          chip.classList.replace('is-alim', 'is-interno');
          chip.textContent = 'Interno';
        } else if (chip.classList.contains('is-interno')) {
          chip.classList.replace('is-interno', 'is-alim');
          chip.textContent = 'Alimentador';
        }
      });
    });
  })();

  // circuit row → highlight in PDF preview
  (function () {
    var rows = document.querySelectorAll('.circuitos-table tbody tr:not(.is-section-divider)');
    var pdfRows = document.querySelectorAll('.pdf-mock-table tbody tr');
    rows.forEach(function (row, idx) {
      row.addEventListener('click', function () {
        rows.forEach(function (r) { r.classList.remove('is-active'); });
        row.classList.add('is-active');
        pdfRows.forEach(function (r) { r.classList.remove('is-highlight'); });
        if (pdfRows[idx]) pdfRows[idx].classList.add('is-highlight');
      });
    });
  })();

  // action-confirm flips to confirmed state
  (function () {
    document.querySelectorAll('.action-confirm').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        btn.style.background = 'var(--color-success)';
        btn.style.color = '#fff';
        btn.textContent = '✓';
        btn.setAttribute('disabled', 'true');
      });
    });
  })();

  // bulk accept alimentadores (confirm all 3 alim rows at once)
  (function () {
    var accept = document.querySelector('.accept-btn');
    if (!accept) return;
    accept.addEventListener('click', function () {
      var rows = document.querySelectorAll('.circuitos-table tbody tr');
      var alimCount = 0;
      rows.forEach(function (tr) {
        if (alimCount >= 3) return;
        var chip = tr.querySelector('.tipo-chip.is-alim');
        if (chip) {
          var btn = tr.querySelector('.action-confirm');
          if (btn) btn.click();
          alimCount++;
        }
      });
      accept.textContent = '✓ 3 confirmados';
      accept.style.background = 'var(--color-success)';
      accept.style.borderColor = 'var(--color-success)';
      accept.setAttribute('disabled', 'true');
    });
  })();
</script>
