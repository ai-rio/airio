---
import ProjectLayout from '../../../layouts/ProjectLayout.astro';
const { id } = Astro.params;
---

<ProjectLayout
  title="airio · Memorial · PROJECT-A PE06"
  step={6}
  doneSteps={[1, 2, 3, 4, 5]}
  projectName="PROJECT-A PE06"
  breadcrumbTail="Memorial"
  contentMaxWidth={1440}
  keymap={['⌘ + Enter · próximo item', '↑↓ · navegar lista', '1 · no BOM', '2 · omisso', '3 · ignorar', 'E · editar']}
  footerLeftText="Memorial salvo automaticamente"
>

<style>
  /* ============ screen body ============ */
  .screen-body {
    width: 100%;
    padding-bottom: var(--space-12);
  }

  /* ============ page header ============ */
  .page-eyebrow {
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-2);
  }
  .page-title {
    font: 600 28px/36px var(--font-sans);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-2);
    color: var(--color-fg-primary);
  }
  .page-lead {
    font: 400 15px/22px var(--font-sans);
    color: var(--color-fg-secondary);
    margin: 0 0 var(--space-6);
    max-width: 80ch;
  }
  .page-lead strong { color: var(--color-fg-primary); font-weight: 600; }

  /* ============ ready strip ============ */
  .ready-strip {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .ready-strip .stat { display: flex; align-items: baseline; gap: var(--space-1); }
  .ready-strip .stat .v {
    font: 600 15px/20px var(--font-sans);
    color: var(--color-fg-primary);
    font-variant-numeric: tabular-nums;
  }
  /* is-pend = pending items needing a decision. Use warning (amber) not accent
     (orange) — the count is non-interactive, so accent's "action signal" role
     doesn't apply. Warning semantically reads "needs attention" without
     competing with the page's single primary CTA. */
  .ready-strip .stat .v.is-ok   { color: var(--color-success); }
  .ready-strip .stat .v.is-warn { color: var(--color-warning); }
  .ready-strip .stat .v.is-pend { color: var(--color-warning); }
  .ready-strip .stat .v.is-muted{ color: var(--color-fg-muted); }
  .ready-strip .stat .l {
    font: 500 11px/16px var(--font-sans);
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .ready-strip .sep   { color: var(--color-fg-disabled); }
  .ready-strip .spacer{ flex: 1; }
  .ready-strip .neutral-note {
    font: 400 12px/16px var(--font-sans);
    color: var(--color-fg-muted);
    font-style: italic;
  }

  /* ============ workspace (split) ============ */
  .workspace {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: var(--space-4);
    min-height: 800px;
  }

  /* ---- left pane: MD item list ---- */
  .md-list {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .md-list-header {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-default);
    background: var(--color-bg-surface);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-fg-muted);
  }
  .md-list-header .count {
    font-family: var(--font-mono);
    color: var(--color-fg-secondary);
  }
  .md-list-body { overflow-y: auto; flex: 1; }

  .md-item {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    cursor: pointer;
    display: grid;
    gap: 4px;
    transition: background var(--motion-fast) var(--ease-default);
  }
  .md-item:hover { background: var(--color-bg-surface); }
  .md-item.is-active {
    background: var(--color-accent-soft-bg);
    border-left: 2px solid var(--color-accent);
    padding-left: calc(var(--space-4) - 2px);
  }
  .md-item-row1 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    justify-content: space-between;
  }
  .md-item-ref {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--color-fg-muted);
    background: var(--color-bg-surface);
    padding: 1px 6px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border-default);
  }
  .md-item.is-active .md-item-ref {
    background: #fff;
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .kind-chip {
    display: inline-flex;
    align-items: center;
    padding: 1px 7px;
    font: 500 10px/14px var(--font-sans);
    border-radius: var(--radius-xs);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    background: var(--color-bg-surface);
    color: var(--color-fg-secondary);
    border: 1px solid var(--color-border-default);
  }
  .kind-chip.k-tomada      { background: #eff6ff; color: #1d4ed8; border-color: transparent; }
  .kind-chip.k-interruptor { background: #ecfdf5; color: #047857; border-color: transparent; }
  /* k-luminaria: amber, not accent orange — decorative chip per DESIGN.md orange discipline */
  .kind-chip.k-luminaria   { background: #fef3c7; color: #92400e; border-color: transparent; }
  .kind-chip.k-cabo        { background: #fce7f3; color: #9d174d; border-color: transparent; }
  .kind-chip.k-infra       { background: #ede9fe; color: #5b21b6; border-color: transparent; }
  .kind-chip.k-quadro      { background: #ccfbf1; color: #115e59; border-color: transparent; }
  .kind-chip.k-aterramento { background: #f3f4f6; color: #374151; border-color: transparent; }
  .kind-chip.k-outro       { background: var(--color-bg-surface); color: var(--color-fg-muted); }

  .md-item-disposition {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    font: 600 12px/1 var(--font-sans);
  }
  .md-item-disposition.is-pendente { background: var(--color-bg-surface); color: var(--color-fg-disabled); border: 1px solid var(--color-border-default); }
  .md-item-disposition.is-bom      { background: var(--color-success-soft-bg); color: var(--color-success); }
  .md-item-disposition.is-omisso   { background: var(--color-warning-soft-bg); color: var(--color-warning); }
  .md-item-disposition.is-ignorado { background: var(--color-bg-surface); color: var(--color-fg-muted); border: 1px solid var(--color-border-default); }

  .md-item-title {
    font: 500 13px/18px var(--font-sans);
    color: var(--color-fg-primary);
    letter-spacing: -0.005em;
  }
  .md-item.is-active .md-item-title { font-weight: 600; }

  .md-item-specs {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg-secondary);
    letter-spacing: 0.01em;
  }

  .md-item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 2px;
  }
  .meta-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 1px 6px;
    font: 500 10px/14px var(--font-sans);
    border-radius: var(--radius-xs);
  }
  .meta-chip.is-brand {
    background: var(--color-accent-soft-bg);
    color: var(--color-accent-soft-fg);
  }
  .meta-chip.is-brand .pin       { font-size: 9px; }
  .meta-chip.is-brand .brand-name{ font-family: var(--font-mono); font-size: 10px; }
  .meta-chip.is-vague {
    background: var(--color-warning-soft-bg);
    color: var(--color-warning);
  }
  .meta-chip.is-fora-escopo {
    background: var(--color-bg-surface);
    color: var(--color-fg-muted);
    border: 1px dashed var(--color-border-default);
  }

  /* ---- right pane: active item ---- */
  .active-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .item-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) 0 var(--space-2);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .item-header h2 {
    font: 600 18px/24px var(--font-sans);
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-fg-primary);
  }
  .item-header .item-ref-display {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg-muted);
    letter-spacing: 0.02em;
  }
  .item-header .item-kind-display {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg-secondary);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    white-space: nowrap;
  }

  /* sub-panel */
  .sub-panel {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .sub-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-default);
    background: var(--color-bg-surface);
  }
  .sub-panel-head h3 {
    font: 600 13px/18px var(--font-sans);
    margin: 0;
    color: var(--color-fg-primary);
    letter-spacing: -0.005em;
  }
  .sub-panel-head .hint {
    font: 400 12px/16px var(--font-sans);
    color: var(--color-fg-muted);
  }
  .sub-panel-body { padding: var(--space-4); }

  /* MD passage */
  .md-passage {
    background: #fffdf7;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    padding: var(--space-5) var(--space-6);
    font: 400 14px/22px var(--font-sans);
    color: var(--color-fg-primary);
    max-height: 320px;
    overflow-y: auto;
    box-shadow: inset 0 0 0 1px rgba(10,10,10,0.02);
  }
  .md-passage h4 {
    font: 600 14px/20px var(--font-sans);
    margin: 0 0 var(--space-3);
    color: var(--color-fg-primary);
    padding-bottom: 4px;
    border-bottom: 1px solid var(--color-border-default);
  }
  .md-passage p {
    margin: 0 0 var(--space-3);
    text-align: justify;
    hyphens: auto;
  }
  .md-passage p:last-child { margin-bottom: 0; }
  /* focused-line = currently-focused passage in the reader. ACTIVE STATE
     per DESIGN.md tokens.md §2: --color-accent role explicitly includes
     "active states". State-tint, not decoration. Orange retained. */
  .md-passage .focused-line {
    background: var(--color-accent-soft-bg);
    border-left: 3px solid var(--color-accent);
    padding: var(--space-2) var(--space-3);
    margin: var(--space-2) 0;
    display: block;
    color: var(--color-fg-primary);
    font-weight: 500;
  }
  .md-passage .nbr-ref {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-fg-secondary);
    background: rgba(10,10,10,0.04);
    padding: 0 4px;
    border-radius: 2px;
  }
  .md-passage-foot {
    margin-top: var(--space-2);
    font: 400 12px/16px var(--font-sans);
    color: var(--color-fg-muted);
    text-align: right;
  }

  /* disposition grid */
  .disposition-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .editar-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-border-default);
  }
  .editar-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 10px;
    background: transparent;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    font: 500 13px/18px var(--font-sans);
    color: var(--color-fg-secondary);
    cursor: pointer;
    transition: border-color var(--motion-fast) var(--ease-default), color var(--motion-fast) var(--ease-default);
  }
  .editar-btn:hover { border-color: var(--color-info); color: var(--color-info); }
  .editar-btn .ico  { color: var(--color-info); }
  .editar-btn .key-hint {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-fg-disabled);
    margin-left: var(--space-2);
    padding: 1px 4px;
    background: var(--color-bg-surface);
    border-radius: 2px;
    border: 1px solid var(--color-border-default);
  }
  .editar-row .editar-note {
    font: 400 12px/16px var(--font-sans);
    color: var(--color-fg-muted);
    font-style: italic;
  }
  .disposition-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: border-color var(--motion-fast) var(--ease-default), background var(--motion-fast) var(--ease-default);
    text-align: left;
    font-family: var(--font-sans);
  }
  .disposition-card:hover { border-color: var(--color-border-strong); }
  .disposition-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .disposition-card .ico {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-xs);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: 600 16px/1 var(--font-sans);
  }
  .disposition-card .label {
    font: 600 14px/20px var(--font-sans);
    color: var(--color-fg-primary);
  }
  .disposition-card .key-hint {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-fg-disabled);
    margin-left: auto;
    align-self: flex-start;
    background: var(--color-bg-surface);
    padding: 1px 4px;
    border-radius: 2px;
    border: 1px solid var(--color-border-default);
  }
  .disposition-card .desc {
    font: 400 12px/16px var(--font-sans);
    color: var(--color-fg-secondary);
  }
  .disposition-card .ico-line {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
  }
  .disposition-card.is-bom .ico       { background: var(--color-success-soft-bg); color: var(--color-success); }
  .disposition-card.is-bom:hover      { border-color: var(--color-success); }
  .disposition-card.is-omisso .ico    { background: var(--color-warning-soft-bg); color: var(--color-warning); }
  .disposition-card.is-omisso:hover   { border-color: var(--color-warning); }
  .disposition-card.is-ignorar .ico   { background: var(--color-bg-surface); color: var(--color-fg-muted); border: 1px solid var(--color-border-default); }
  .disposition-card.is-ignorar:hover  { border-color: var(--color-fg-muted); }

  .disposition-card.is-selected.is-bom    { background: var(--color-success-soft-bg); border-color: var(--color-success); }
  .disposition-card.is-selected.is-omisso { background: var(--color-warning-soft-bg); border-color: var(--color-warning); }
  .disposition-card.is-selected.is-ignorar{ background: var(--color-bg-surface); border-color: var(--color-fg-muted); }

  /* pin brand field */
  .pin-brand {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-3);
    align-items: center;
  }
  .pin-brand label {
    font: 500 12px/16px var(--font-sans);
    color: var(--color-fg-secondary);
  }
  .pin-brand input {
    font: 400 13px/18px var(--font-sans);
    padding: 6px 10px;
    background: var(--color-bg-input);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    color: var(--color-fg-primary);
    width: 100%;
  }
  .pin-brand input:focus-visible {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft-bg);
  }
  .pin-brand .pin-hint {
    font: 400 11px/14px var(--font-sans);
    color: var(--color-fg-muted);
  }

  .disposition-foot {
    margin-top: var(--space-3);
    font: 400 12px/16px var(--font-sans);
    color: var(--color-fg-muted);
    font-style: italic;
  }

  /* ============ form actions ============ */
  .form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
  }
  .form-meta { font: 400 12px/16px var(--font-sans); color: var(--color-fg-muted); }
  .form-actions .btn-group { display: flex; gap: var(--space-2); }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font: 500 13px/18px var(--font-sans);
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition: background var(--motion-fast) var(--ease-default), border-color var(--motion-fast) var(--ease-default);
  }
  .btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .btn-primary { background: var(--color-accent); color: #fff; text-decoration: none; }
  .btn-primary:hover { background: var(--color-accent-hover); }
  .btn-primary.is-disabled { background: var(--color-bg-disabled); color: var(--color-fg-disabled); cursor: not-allowed; }
  .btn-ghost { background: transparent; color: var(--color-fg-secondary); text-decoration: none; }
  .btn-ghost:hover { background: var(--color-bg-surface); color: var(--color-fg-primary); }

  /* ============ responsive ============ */
  @media (max-width: 1200px) {
    .workspace { grid-template-columns: 340px 1fr; }
    .disposition-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .page-title { font-size: 22px; line-height: 30px; }
    .workspace { grid-template-columns: 1fr; min-height: auto; }
    .md-list { max-height: 360px; overflow-y: auto; }
    .ready-strip { flex-direction: column; align-items: flex-start; }
    .ready-strip .spacer { display: none; }
    .disposition-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="screen-body">

  <div class="page-eyebrow">Etapa 6 de 8 · Memorial Descritivo</div>
  <h1 class="page-title">Confere o que o memorial promete</h1>
  <p class="page-lead">O airio leu o memorial descritivo e listou cada componente prometido com a seção de referência. Pra cada item, decide: <strong>tem no BOM</strong> · <strong>vira omisso</strong> (consultar cliente) · <strong>fora de escopo</strong>. O airio não pré-marca nada — seu olho continua sendo a referência.</p>

  <!-- ready strip — no global bulk per S8 neutral-disposition rule -->
  <div class="ready-strip" role="region" aria-label="Estado do memorial">
    <div class="stat"><span class="v">12</span><span class="l">Itens extraídos</span></div>
    <span class="sep">·</span>
    <div class="stat"><span class="v is-pend">9</span><span class="l">Pendentes</span></div>
    <span class="sep">·</span>
    <div class="stat"><span class="v is-ok">1</span><span class="l">No BOM</span></div>
    <span class="sep">·</span>
    <div class="stat"><span class="v is-warn">1</span><span class="l">Omisso</span></div>
    <span class="sep">·</span>
    <div class="stat"><span class="v is-muted">1</span><span class="l">Ignorado</span></div>
    <span class="spacer"></span>
    <span class="neutral-note">Sem ação em massa — cada item você decide.</span>
  </div>

  <!-- 2-pane workspace -->
  <div class="workspace">

    <!-- LEFT: MD item list -->
    <aside class="md-list" aria-label="Itens do memorial">
      <div class="md-list-header">
        <span>Itens do memorial</span>
        <span class="count">12</span>
      </div>
      <div class="md-list-body">

        <div class="md-item" tabindex="0" data-section="7.1.3" data-kind="cabo">
          <div class="md-item-row1">
            <span class="md-item-ref">7.1.3</span>
            <span class="kind-chip k-cabo">cabo</span>
            <span class="md-item-disposition is-pendente" title="Pendente">·</span>
          </div>
          <span class="md-item-title">Cabo flexível HEPR 90°C 0,6/1kV</span>
          <span class="md-item-specs">classe 5 · NBR 13248 · cobre estanhado</span>
        </div>

        <div class="md-item" tabindex="0" data-section="7.1.4" data-kind="interruptor">
          <div class="md-item-row1">
            <span class="md-item-ref">7.1.4</span>
            <span class="kind-chip k-interruptor">interruptor</span>
            <span class="md-item-disposition is-pendente">·</span>
          </div>
          <span class="md-item-title">Interruptores simples e paralelo</span>
