---
import ProjectLayout from '../../../../layouts/ProjectLayout.astro';
const { id } = Astro.params;
---

<ProjectLayout
  title="airio · Legenda · PROJECT-A PE06"
  step={4}
  doneSteps={[1, 2, 3]}
  projectName="PROJECT-A PE06"
  breadcrumbParents={["Preparação"]}
  breadcrumbTail="Legenda"
  keymap={['⌘ + Enter · próxima linha', '↑↓ · navegar', 'A · aceitar todos', 'E · expandir/recolher']}
  contentMaxWidth={1280}
>

<style>
  /* ============ screen body ============ */
  .screen-body {
    width: 100%;
    padding-bottom: var(--space-12);
  }

  /* ============ page header ============ */
  .page-eyebrow {
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-2);
  }
  .page-title {
    font: 600 28px/36px var(--font-sans);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-2);
    color: var(--color-fg-primary);
  }
  .page-lead {
    font: 400 15px/22px var(--font-sans);
    color: var(--color-fg-secondary);
    margin: 0 0 var(--space-6);
    max-width: 78ch;
  }
  .page-lead strong { color: var(--color-fg-primary); font-weight: 600; }

  /* ============ meta bar — intel evidence ============ */
  .meta-bar {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .meta-bar .stat { display: flex; align-items: baseline; gap: var(--space-1); }
  .meta-bar .stat .v {
    font: 600 15px/20px var(--font-sans);
    color: var(--color-fg-primary);
    font-variant-numeric: tabular-nums;
  }
  .meta-bar .stat .v.is-ok { color: var(--color-success); }
  .meta-bar .stat .l {
    font: 500 11px/16px var(--font-sans);
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .meta-bar .sep { color: var(--color-fg-disabled); }
  .meta-bar .spacer { flex: 1; }

  /* intel pill — info blue, not orange */
  .intel-pill {
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: 4px 10px;
    font: 500 11px/16px var(--font-mono);
    background: var(--color-info-soft-bg);
    color: var(--color-info);
    border: 1px solid var(--color-info-soft-border);
    border-radius: var(--radius-sm);
  }
  .intel-pill .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--color-info);
  }

  /* bulk accept CTA — orange is correct here (primary action) */
  .meta-bar .bulk-btn {
    font: 500 13px/18px var(--font-sans);
    padding: 6px 12px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    color: var(--color-fg-primary);
    cursor: pointer;
    display: inline-flex; align-items: center; gap: var(--space-2);
  }
  .meta-bar .bulk-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }

  /* ============================================
     LEGEND CARD — top panel
     ============================================ */
  .legend-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-4);
  }
  .legend-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-default);
    background: var(--color-bg-surface);
  }
  .legend-header-label {
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-fg-muted);
  }
  .legend-source {
    font: 400 11px/16px var(--font-mono);
    color: var(--color-fg-muted);
  }
  .legend-source .file { color: var(--color-fg-secondary); }
  .legend-actions { display: flex; gap: var(--space-2); }
  .legend-action-btn {
    font: 500 12px/16px var(--font-sans);
    padding: 4px 10px;
    background: transparent;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    color: var(--color-fg-secondary);
    cursor: pointer;
  }
  /* hover = interactive affordance (accent on hover is canonical) */
  .legend-action-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }

  .legend-image {
    padding: var(--space-6) var(--space-4);
    background: #fdfcfa;
    background-image:
      linear-gradient(to right, rgba(0,0,0,0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0,0,0,0.03) 1px, transparent 1px);
    background-size: 8px 8px;
    border-bottom: 1px solid var(--color-border-default);
    display: flex; justify-content: center;
    overflow-x: auto;
  }
  .legend-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(120px, 1fr));
    gap: 0;
    font: 500 11px/16px var(--font-mono);
    color: var(--color-fg-primary);
    min-width: 980px;
    background: #ffffff;
    border: 1px solid var(--color-border-strong);
  }
  .legend-cell {
    padding: var(--space-3) var(--space-2);
    display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
    gap: var(--space-2);
    border-right: 1px solid var(--color-border-default);
    border-bottom: 1px solid var(--color-border-default);
    min-height: 84px;
  }
  .legend-cell:nth-child(7n) { border-right: none; }
  .legend-cell:last-child { border-bottom: none; }
  .legend-glyph {
    font: 400 24px/1 var(--font-mono);
    /* tomada family (incl. AC): magenta per symbol_counting memory.
       AC = same ELE_ST circle glyph as tomada — geometry identical on PE06.
       No .is-ac class applied — both render magenta. */
    color: #c026d3;
    letter-spacing: 0;
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 28px;
  }
  /* interruptor = blue */
  .legend-glyph.is-switch { color: #1d4ed8; }
  /* luminária = amber (CAD amber overlay per DESIGN.md §PDF Overlays perfilado token #ca8a04) */
  .legend-glyph.is-light { color: #ca8a04; }
  /* emergência = success green */
  .legend-glyph.is-em { color: var(--color-success); }
  /* aterramento BES = secondary charcoal */
  .legend-glyph.is-bes { color: var(--color-fg-secondary); }
  /* NOTE: no .is-ac class — AC glyph is same magenta ⊖ as tomada (memory-correct) */
  .legend-label {
    font: 500 10px/14px var(--font-mono);
    color: var(--color-fg-secondary);
    text-align: center;
    letter-spacing: 0;
  }

  .legend-foot {
    padding: var(--space-3) var(--space-4);
    display: flex; justify-content: space-between; align-items: center;
    font: 400 12px/16px var(--font-sans);
    color: var(--color-fg-muted);
  }
  .legend-foot .summary { font-weight: 500; color: var(--color-fg-secondary); }
  .legend-foot .summary strong { color: var(--color-fg-primary); font-weight: 600; }

  /* ============================================
     DEVICE LIST — middle panel
     ============================================ */
  .devices-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-4);
  }
  .devices-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-default);
    background: var(--color-bg-surface);
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-fg-muted);
  }
  .devices-header .count { font-family: var(--font-mono); color: var(--color-fg-secondary); }
  .devices-header .add-btn {
    font: 500 12px/16px var(--font-sans);
    padding: 4px 10px;
    background: transparent;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    color: var(--color-fg-secondary);
    cursor: pointer;
    text-transform: none;
    letter-spacing: 0;
  }
  /* hover = interactive affordance */
  .devices-header .add-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }

  .device-row {
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .device-row:last-child { border-bottom: none; }
  /* is-expanded state-change tint — permitted by orange-discipline memory ("state-change tint") */
  .device-row.is-expanded { background: var(--color-accent-soft-bg); }

  .device-row-summary {
    display: grid;
    grid-template-columns: 28px 200px 140px 130px 1fr 130px 28px;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    transition: background var(--motion-fast) var(--ease-default);
  }
  .device-row-summary:hover { background: var(--color-bg-surface); }
  .device-row.is-expanded .device-row-summary:hover { background: var(--color-accent-soft-bg); }

  /* expanded-row chevron = state-change marker (parallel to expanded-row tint) */
  .chevron {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-fg-muted);
    transition: transform var(--motion-fast) var(--ease-default);
    display: inline-block;
  }
  .device-row.is-expanded .chevron { transform: rotate(90deg); color: var(--color-accent); }

  .device-name {
    font: 600 16px/22px var(--font-sans);
    color: var(--color-fg-primary);
    letter-spacing: -0.005em;
  }

  .layer-chip {
    display: inline-flex; align-items: center;
    padding: 3px 8px;
    font: 500 11px/16px var(--font-mono);
    background: var(--color-bg-surface);
    color: var(--color-fg-primary);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xs);
    letter-spacing: 0;
    width: max-content;
  }

  .detector-type {
    font: 400 12px/16px var(--font-mono);
    color: var(--color-fg-muted);
  }

  .variants-summary {
    font: 400 13px/18px var(--font-sans);
    color: var(--color-fg-secondary);
  }
  .variants-summary .count { color: var(--color-fg-primary); font-weight: 500; }
  /*
   * DESIGN.md orange-discipline: finalized had strong { color: var(--color-accent-soft-fg) }
   * here = decorative emphasis on default-variant name = VIOLATION.
   * Patched to --color-fg-secondary per feedback_design_md_orange_discipline.md tone-down pattern.
   */
  .variants-summary .default {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg-muted);
  }
  .variants-summary .default strong { color: var(--color-fg-secondary); font-weight: 500; }

  .device-status {
    display: inline-flex; align-items: center; gap: 6px;
    font: 500 11px/16px var(--font-sans);
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .device-status .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--color-fg-muted);
  }
  .device-status.is-confirmed { color: var(--color-success); }
  .device-status.is-confirmed .dot { background: var(--color-success); }
  .device-status.is-pending { color: var(--color-warning); }
  .device-status.is-pending .dot { background: var(--color-warning); }

  .quick-confirm {
    display: inline-flex; align-items: center; justify-content: center;
    width: 24px; height: 24px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-surface);
    color: var(--color-fg-muted);
    border: 1px solid var(--color-border-default);
    cursor: pointer;
    font-size: 11px;
  }
  /* hover = interactive affordance */
  .quick-confirm:hover { border-color: var(--color-success); color: var(--color-success); background: var(--color-success-soft-bg); }
  .quick-confirm.is-confirmed { background: var(--color-success); color: #fff; border-color: var(--color-success); }

  /* expanded panel */
  .device-row-body {
    display: none;
    padding: var(--space-2) var(--space-4) var(--space-6) calc(var(--space-4) + 28px + var(--space-3));
    border-top: 1px solid var(--color-border-subtle);
  }
  .device-row.is-expanded .device-row-body { display: block; }

  .body-grid {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--space-3) var(--space-6);
    align-items: start;
    padding-top: var(--space-3);
  }
  .body-label {
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-fg-muted);
    padding-top: 6px;
  }
  .body-field { font: 400 13px/18px var(--font-sans); color: var(--color-fg-primary); }

  /* glyph sample inside expanded row */
  .glyph-sample {
    display: inline-flex; align-items: center; justify-content: center;
    width: 56px; height: 56px;
    background: #fdfcfa;
    background-image:
      linear-gradient(to right, rgba(0,0,0,0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0,0,0,0.04) 1px, transparent 1px);
    background-size: 6px 6px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    /* tomada glyph = magenta per symbol_counting memory */
    color: #c026d3;
    font: 400 32px/1 var(--font-mono);
  }

  /* variant chips */
  .variant-chips {
    display: flex; flex-wrap: wrap; gap: var(--space-2);
    align-items: center;
  }
  .variant-chip {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 4px 5px 10px;
    font: 500 12px/16px var(--font-mono);
    background: var(--color-bg-elevated);
    color: var(--color-fg-primary);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    letter-spacing: 0;
  }
  .variant-chip .close {
    display: inline-flex; align-items: center; justify-content: center;
    width: 18px; height: 18px;
    background: transparent;
    border: none;
    color: var(--color-fg-muted);
    cursor: pointer;
    border-radius: var(--radius-xs);
    font-size: 13px;
    line-height: 1;
  }
  .variant-chip .close:hover { background: var(--color-danger-soft-bg); color: var(--color-danger); }
  /*
   * .is-default: neutral treatment per orange-discipline memory.
   * "padrão:" prefix = italic muted text. No orange. No decorative accent.
   */
  .variant-chip.is-default {
    background: var(--color-bg-surface);
    color: var(--color-fg-primary);
    border-color: var(--color-border-strong);
  }
  .variant-chip.is-default .tag {
    font: italic 500 11px/16px var(--font-sans);
    color: var(--color-fg-muted);
    letter-spacing: 0;
    text-transform: none;
    margin-right: 2px;
  }
  /* vchip glyphs mirror legend color semantics */
  .vchip-glyph {
    font: 400 16px/1 var(--font-mono);
    color: #c026d3;
    margin-right: 4px;
    display: inline-block;
    min-width: 14px;
    text-align: center;
  }
  .vchip-glyph.is-switch { color: #1d4ed8; }
  .vchip-glyph.is-light { color: #ca8a04; }
  .vchip-glyph.is-em { color: var(--color-success); }
  .vchip-glyph.is-bes { color: var(--color-fg-secondary); }
  /* NOTE: no .vchip-glyph.is-ac — AC uses default magenta (same glyph as tomada) */

  .variant-add {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 5px 10px;
    font: 500 12px/16px var(--font-mono);
    background: transparent;
    color: var(--color-fg-muted);
    border: 1px dashed var(--color-border-default);
    border-radius: var(--radius-sm);
    cursor: pointer;
    letter-spacing: 0;
  }
  /* hover = interactive affordance */
  .variant-add:hover { border-style: solid; border-color: var(--color-accent); color: var(--color-accent); }

  /* inline form controls */
  .body-select {
    font: 500 13px/18px var(--font-mono);
    padding: 6px 28px 6px 10px;
    background: var(--color-bg-input);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    color: var(--color-fg-primary);
    cursor: pointer;
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--color-fg-muted) 50%), linear-gradient(135deg, var(--color-fg-muted) 50%, transparent 50%);
    background-position: calc(100% - 14px) 50%, calc(100% - 8px) 50%;
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
    letter-spacing: 0;
  }
  /* focus = focus ring (canonical orange use) */
  .body-select:focus { outline: 2px solid var(--color-accent); outline-offset: 1px; }

  .body-hint {
    font: 400 12px/18px var(--font-sans);
    color: var(--color-fg-muted);
    max-width: 64ch;
  }
  .body-hint .em { color: var(--color-fg-secondary); font-weight: 500; }
  .body-hint code {
    font-family: var(--font-mono);
    font-size: 11px;
    background: var(--color-bg-surface);
    padding: 1px 4px;
    border-radius: var(--radius-xs);
  }

  .body-actions {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-3);
    margin-top: var(--space-3);
    border-top: 1px dashed var(--color-border-default);
  }
  .body-confidence {
    display: flex; align-items: center; gap: var(--space-2);
    font: 400 11px/16px var(--font-mono);
    color: var(--color-fg-muted);
  }
  .body-confidence .level {
    color: var(--color-success);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .body-confidence .level.is-medium { color: var(--color-warning); }
  .body-confidence .level.is-low { color: var(--color-danger); }

  .body-danger-btn {
    font: 500 12px/16px var(--font-sans);
    padding: 4px 10px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--color-fg-muted);
    cursor: pointer;
  }
  .body-danger-btn:hover { color: var(--color-danger); border-color: var(--color-danger); background: var(--color-danger-soft-bg); }

  /* ============================================
     NEGATIVE LAYERS CARD
     ============================================ */
  .negative-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .negative-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: var(--space-3);
  }
  .negative-label {
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-fg-muted);
  }
  .negative-label .count { font-family: var(--font-mono); color: var(--color-fg-secondary); margin-left: var(--space-2); }
  .negative-help { font: 400 12px/18px var(--font-sans); color: var(--color-fg-muted); max-width: 78ch; margin: 0 0 var(--space-3); }
  .negative-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .negative-chip {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 4px 4px 10px;
    font: 500 11px/16px var(--font-mono);
    background: var(--color-bg-surface);
    color: var(--color-fg-secondary);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xs);
    letter-spacing: 0;
  }
  .negative-chip .close {
    display: inline-flex; align-items: center; justify-content: center;
    width: 18px; height: 18px;
    background: transparent;
    border: none;
    color: var(--color-fg-muted);
    cursor: pointer;
    border-radius: var(--radius-xs);
    font-size: 13px;
    line-height: 1;
  }
  /* hover = interactive affordance */
  .negative-chip .close:hover { color: var(--color-accent); }
  .negative-chip .add-btn {
    font-family: var(--font-sans);
    font-size: 12px;
    text-transform: none;
    letter-spacing: 0;
  }

  /* ============================================
     FORM ACTIONS
     ============================================ */
  .form-actions {
    display: flex; align-items: center; justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-default);
  }
  .form-meta {
    font: 400 12px/18px var(--font-sans);
    color: var(--color-fg-muted);
  }
  .form-meta .mono { color: var(--color-fg-secondary); font-family: var(--font-mono); }
  .btn-group { display: flex; gap: var(--space-2); }
  .btn {
    font: 500 14px/20px var(--font-sans);
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-default);
    background: var(--color-bg-elevated);
    color: var(--color-fg-primary);
    cursor: pointer;
  }
  .btn:hover { border-color: var(--color-fg-secondary); }
  .btn-ghost { background: transparent; text-decoration: none; }
  .btn-ghost:hover { background: var(--color-bg-surface); }
  /* primary CTA — orange is canonical here (one per screen) */
  .btn-primary {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .btn-primary:hover { background: var(--color-accent-hover); border-color: var(--color-accent-hover); }

  /* ============ responsive ============ */
  @media (max-width: 1024px) {
    .device-row-summary {
      grid-template-columns: 24px 180px 130px 1fr 110px 28px;
    }
    .device-row-summary .detector-type { display: none; }
    .legend-grid { grid-template-columns: repeat(4, minmax(120px, 1fr)); min-width: 560px; }
  }
  @media (max-width: 768px) {
    .device-row-summary {
      grid-template-columns: 24px 1fr 28px;
      gap: var(--space-2);
    }
    .device-row-summary .layer-chip,
