<script is:inline>
  // MD item activation — click to switch active item
  (function () {
    const items = document.querySelectorAll('.md-item');
    items.forEach(function (item) {
      item.addEventListener('click', function () {
        items.forEach(function (i) { i.classList.remove('is-active'); });
        item.classList.add('is-active');
      });
      item.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); item.click(); }
      });
    });
  })();

  // Disposition card selection (one of 3 — Editar is a separate meta-action)
  (function () {
    const cards = document.querySelectorAll('.disposition-card');
    cards.forEach(function (card) {
      card.addEventListener('click', function () {
        cards.forEach(function (c) { c.classList.remove('is-selected'); });
        card.classList.add('is-selected');
      });
    });
  })();

  // Keyboard shortcuts: 1 = BOM, 2 = omisso, 3 = ignorar, E = editar
  (function () {
    document.addEventListener('keydown', function (e) {
      if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
      var map = { '1': 'bom', '2': 'omisso', '3': 'ignorar' };
      if (map[e.key]) {
        var card = document.querySelector('.disposition-card[data-action="' + map[e.key] + '"]');
        if (card) card.click();
      }
      if (e.key === 'e' || e.key === 'E') {
        var editar = document.querySelector('.editar-btn');
        if (editar) editar.focus();
      }
    });
  })();
</script>
