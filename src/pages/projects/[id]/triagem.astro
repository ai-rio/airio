    <article class="sheet-card">
      <div class="thumb" style="background: repeating-linear-gradient(0deg, rgba(10,10,10,0.06) 0 1px, transparent 1px 14px), var(--color-bg-surface);">
        <div class="thumb-overlay">
          <span class="thumb-sheet-num">PE-ELE-QDC · 01/04</span>
          <span class="thumb-status-dot"></span>
        </div>
        <span class="thumb-checkbox"><input type="checkbox" aria-label="Selecionar prancha" /></span>
      </div>
      <div class="sheet-meta">
        <span class="sheet-title">Quadro de Cargas QGBT</span>
        <span class="sheet-subtitle">Tabela · 38 circuitos</span>
