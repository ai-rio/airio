---
import ProjectLayout from '../../../../layouts/ProjectLayout.astro';
const { id } = Astro.params;
---

<ProjectLayout
  title="airio · Preparação · PROJECT-A PE06"
  step={4}
  doneSteps={[1, 2, 3]}
  projectName="PROJECT-A PE06"
  breadcrumbTail="Preparação"
  keymap={['⌘ + Enter · próxima prancha', '↑↓ · navegar lista', 'A · aceitar todas']}
  footerLeftText="Preparação salva automaticamente"
  contentMaxWidth={1440}
>

<style>
  /* ============ screen body ============ */
  .screen-body {
    width: 100%;
    padding-bottom: var(--space-12);
  }

  /* ============ page header ============ */
  .page-eyebrow {
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-2);
  }
  .page-title {
    font: 600 28px/36px var(--font-sans);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-2);
    color: var(--color-fg-primary);
  }
  .page-lead {
    font: 400 15px/22px var(--font-sans);
    color: var(--color-fg-secondary);
    margin: 0 0 var(--space-6);
    max-width: 78ch;
  }
  .page-lead strong { color: var(--color-fg-primary); font-weight: 600; }

  /* ============ ready strip ============ */
  .ready-strip {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .ready-strip .stat { display: flex; align-items: baseline; gap: var(--space-1); }
  .ready-strip .stat .v {
    font: 600 15px/20px var(--font-sans);
    color: var(--color-fg-primary);
    font-variant-numeric: tabular-nums;
  }
  .ready-strip .stat .v.is-ok { color: var(--color-success); }
  .ready-strip .stat .v.is-warn { color: var(--color-warning); }
  .ready-strip .stat .l { font: 500 11px/16px var(--font-sans); color: var(--color-fg-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .ready-strip .sep { color: var(--color-fg-disabled); }
  .ready-strip .spacer { flex: 1; }
  .ready-strip .bulk-btn {
    font: 500 13px/18px var(--font-sans);
    padding: 6px 12px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    color: var(--color-fg-primary);
    cursor: pointer;
    display: inline-flex; align-items: center; gap: var(--space-2);
  }
  .ready-strip .bulk-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .ready-strip .bulk-btn .icon { color: var(--color-accent); }

  /* ============ 2-pane workspace ============ */
  .workspace {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--space-4);
    min-height: 720px;
  }

  /* ============ left pane: sheet list ============ */
  .sheet-list {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex; flex-direction: column;
  }
  .sheet-list-header {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-default);
    background: var(--color-bg-surface);
    display: flex; align-items: center; justify-content: space-between;
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-fg-muted);
  }
  .sheet-list-header .count { font-family: var(--font-mono); color: var(--color-fg-secondary); }

  .sheet-row {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    cursor: pointer;
    align-items: center;
    transition: background var(--motion-fast) var(--ease-default);
  }
  .sheet-row:hover { background: var(--color-bg-surface); }
  .sheet-row.is-active {
    background: var(--color-accent-soft-bg);
    border-left: 2px solid var(--color-accent);
    padding-left: calc(var(--space-4) - 2px);
  }
  .sheet-row.is-active .row-title { color: var(--color-fg-primary); }

  .row-thumb {
    width: 44px; height: 32px;
    background:
      repeating-linear-gradient(0deg, rgba(10,10,10,0.05) 0 1px, transparent 1px 6px),
      repeating-linear-gradient(90deg, rgba(10,10,10,0.05) 0 1px, transparent 1px 6px),
      var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xs);
    position: relative;
    overflow: hidden;
  }
  .row-thumb::after {
    content: '';
    position: absolute; left: 4px; right: 4px; top: 8px; bottom: 8px;
    border: 1px solid rgba(10,10,10,0.18);
  }
  .row-thumb.is-blank::after { display: none; }

  .row-meta { display: grid; gap: 2px; min-width: 0; }
  .row-num {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.02em;
    color: var(--color-fg-muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .row-title {
    font: 500 13px/18px var(--font-sans);
    color: var(--color-fg-secondary);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .row-pavimento {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-fg-muted);
  }

  .row-status {
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px;
    border-radius: 50%;
    font: 600 12px/1 var(--font-sans);
  }
  .row-status.is-pronta { background: var(--color-success-soft-bg); color: var(--color-success); }
  .row-status.is-ajustes { background: var(--color-warning-soft-bg); color: var(--color-warning); }
  .row-status.is-pendente { background: var(--color-bg-surface); color: var(--color-fg-disabled); border: 1px solid var(--color-border-default); }

  /* ============ right pane: active sheet ============ */
  .active-sheet {
    display: flex; flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .sheet-header {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) 0 var(--space-2);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .sheet-header h2 {
    font: 600 18px/24px var(--font-sans);
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-fg-primary);
  }
  .sheet-header .sheet-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg-muted);
    letter-spacing: 0.02em;
  }
  .sheet-header .sheet-pavimento {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg-secondary);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
  }

  /* ============ sub-panel base ============ */
  .sub-panel {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .sub-panel-head {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-default);
    background: var(--color-bg-surface);
  }
  .sub-panel-head h3 {
    font: 600 13px/18px var(--font-sans);
    margin: 0;
    color: var(--color-fg-primary);
    letter-spacing: -0.005em;
  }
  .sub-panel-head .hint {
    font: 400 12px/16px var(--font-sans);
    color: var(--color-fg-muted);
  }
  .sub-panel-body { padding: var(--space-4); }

  /* ============ escala panel ============ */
  .escala-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-6);
    align-items: center;
  }
  .titleblock-crop {
    position: relative;
    aspect-ratio: 11 / 7;
    background: var(--color-bg-app);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .titleblock-crop .tb-grid {
    position: absolute; inset: 8px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-border-default);
  }
  .titleblock-crop .tb-cell {
    background: var(--color-bg-app);
    padding: 4px 6px;
    font-family: var(--font-mono);
    font-size: 8px;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    overflow: hidden;
  }
  .titleblock-crop .tb-cell strong {
    color: var(--color-fg-secondary); font-weight: 500; display: block; font-size: 7px; margin-bottom: 1px;
  }
  .titleblock-crop .tb-highlight {
    position: absolute;
    bottom: 18px; left: 8px;
    width: 102px; height: 18px;
    border: 1.5px solid var(--color-accent);
    border-radius: 2px;
    pointer-events: none;
    box-shadow: 0 0 0 3px var(--color-accent-soft-bg);
  }
  .titleblock-crop .tb-arrow {
    position: absolute;
    bottom: 4px; left: 8px;
    font-family: var(--font-mono);
    font-size: 8px;
    color: var(--color-accent);
    font-weight: 600;
  }

  .escala-read { display: grid; gap: var(--space-3); }
  .escala-value-row { display: flex; align-items: baseline; gap: var(--space-3); }
  .escala-value {
    font: 600 44px/1 var(--font-mono);
    letter-spacing: -0.02em;
    color: var(--color-fg-primary);
    font-variant-numeric: tabular-nums;
  }
  .escala-value .colon { color: var(--color-fg-muted); margin: 0 4px; font-weight: 400; }
  .escala-source-chip {
    display: inline-flex; align-items: center; gap: var(--space-1);
    padding: 3px 8px;
    background: var(--color-success-soft-bg);
    color: var(--color-success);
    font: 500 11px/16px var(--font-sans);
    border-radius: var(--radius-xs);
  }
  .escala-source-chip .src-mono {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-success);
    margin-left: var(--space-1);
    opacity: 0.85;
  }
  .escala-help { font: 400 13px/18px var(--font-sans); color: var(--color-fg-secondary); margin: 0; }
  .escala-actions { display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-1); }
  .escala-fallback {
    font: 400 12px/16px var(--font-sans);
    color: var(--color-fg-muted);
    margin-top: var(--space-1);
  }
  .escala-fallback a {
    color: var(--color-info);
    text-decoration: none;
    border-bottom: 1px dotted var(--color-info);
  }
  .escala-fallback a:hover { border-bottom-style: solid; }
  .escala-fallback .sep { color: var(--color-fg-disabled); margin: 0 var(--space-1); }

  /* ============ camadas panel ============ */
  /*
   * DESIGN.md orange-discipline: the bulk banner uses accent-soft-bg as a tinted panel.
   * Per S2 t-quadro precedent: decorative/attention tints → amber family.
   * The orange CTA button (.accept-btn) is the action signal — it stays accent.
   * The surrounding panel tint is patched from #fff7ed/#9a3412 to amber #fef3c7/#92400e.
   */
  .camadas-bulk {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: #fef3c7;  /* amber-100 (was accent-soft-bg #fff7ed) — DESIGN.md patch */
    border-bottom: 1px solid #fef3c7;
  }
  .camadas-bulk-text {
    font: 500 13px/18px var(--font-sans);
    color: #92400e;  /* amber-800 (was accent-soft-fg #9a3412) — DESIGN.md patch */
  }
  .camadas-bulk-text strong { font-weight: 600; }
  .camadas-bulk .accept-btn {
    font: 500 12px/16px var(--font-sans);
    padding: 5px 10px;
    background: var(--color-accent);
    color: #fff;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-xs);
    cursor: pointer;
  }
  .camadas-bulk .accept-btn:hover { background: var(--color-accent-hover); border-color: var(--color-accent-hover); }

  .camadas-table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .camadas-table thead th {
    text-align: left;
    font: 500 10px/14px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
    background: var(--color-bg-surface);
    padding: 8px var(--space-4);
    border-bottom: 1px solid var(--color-border-default);
  }
  .camadas-table tbody td {
    padding: 8px var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    vertical-align: middle;
    font: 400 13px/18px var(--font-sans);
    color: var(--color-fg-primary);
  }
  .camadas-table tbody tr:hover { background: var(--color-bg-surface); }
  .camadas-table tbody tr:last-child td { border-bottom: none; }
  .camadas-table tbody tr.is-warn { background: var(--color-warning-soft-bg); }

  .layer-name {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg-primary);
  }
  .kind-select {
    font: 500 12px/16px var(--font-sans);
    padding: 4px 8px;
    background: var(--color-bg-input);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xs);
    color: var(--color-fg-primary);
    min-width: 130px;
  }
  .kind-select:hover { border-color: var(--color-border-strong); }
  .kind-select:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; border-color: var(--color-accent); }
  .kind-select.is-unconfirmed { border-color: var(--color-warning); background: #fffbeb; }

  .src-chip {
    display: inline-flex; align-items: center; gap: var(--space-1);
    padding: 2px 7px;
    font: 500 11px/16px var(--font-sans);
    border-radius: var(--radius-xs);
    white-space: nowrap;
  }
  .src-chip .pip { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
  .src-chip.is-hist { background: var(--color-success-soft-bg); color: var(--color-success); }
  .src-chip.is-hist .pip { background: var(--color-success); }
  .src-chip.is-glossary { background: var(--color-info-soft-bg); color: var(--color-info); }
  .src-chip.is-glossary .pip { background: var(--color-info); }
  .src-chip.is-intel { background: var(--color-warning-soft-bg); color: var(--color-warning); }
  .src-chip.is-intel .pip { background: var(--color-warning); }
  .src-chip.is-none { background: var(--color-bg-surface); color: var(--color-fg-muted); border: 1px solid var(--color-border-default); }
  .src-chip.is-none .pip { background: var(--color-fg-disabled); }
  .src-chip .src-detail { font-family: var(--font-mono); font-size: 10px; opacity: 0.8; }

  .action-cell { text-align: right; }
  .action-confirm {
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px;
    background: var(--color-success-soft-bg);
    color: var(--color-success);
    border: 1px solid var(--color-success-soft-bg);
    border-radius: var(--radius-xs);
    font: 600 13px/1 var(--font-sans);
    cursor: pointer;
  }
  .action-confirm:hover { background: var(--color-success); color: #fff; }
  .action-pending {
    font: 500 11px/16px var(--font-sans);
    color: var(--color-fg-muted);
    background: var(--color-bg-surface);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border-default);
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .action-pending:hover { border-color: var(--color-accent); color: var(--color-accent); }

  .camadas-foot {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-surface);
    border-top: 1px solid var(--color-border-default);
    font: 400 12px/16px var(--font-sans);
    color: var(--color-fg-secondary);
  }
  .camadas-foot .counter { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .camadas-foot .counter .ok { color: var(--color-success); font-weight: 500; }
  .camadas-foot .counter .pend { color: var(--color-warning); font-weight: 500; }

  /* ============ form actions ============ */
  .form-actions {
    display: flex; justify-content: space-between; align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
  }
  .form-meta { font: 400 12px/16px var(--font-sans); color: var(--color-fg-muted); }
  .form-actions .btn-group { display: flex; gap: var(--space-2); }

  .btn {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font: 500 13px/18px var(--font-sans);
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition: background var(--motion-fast) var(--ease-default), border-color var(--motion-fast) var(--ease-default);
  }
  .btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .btn-primary { background: var(--color-accent); color: #fff; text-decoration: none; }
  .btn-primary:hover { background: var(--color-accent-hover); }
  .btn-primary.is-disabled,
  .btn-primary:disabled { background: var(--color-bg-disabled); color: var(--color-fg-disabled); cursor: not-allowed; }
  .btn-secondary { background: var(--color-bg-elevated); color: var(--color-fg-primary); border-color: var(--color-border-default); text-decoration: none; }
  .btn-secondary:hover { background: var(--color-bg-surface); border-color: var(--color-border-strong); }
  .btn-ghost { background: transparent; color: var(--color-fg-secondary); text-decoration: none; }
  .btn-ghost:hover { background: var(--color-bg-surface); color: var(--color-fg-primary); }

  /* ============ responsive ============ */
  @media (max-width: 1024px) {
    .workspace { grid-template-columns: 280px 1fr; }
    .escala-grid { grid-template-columns: 180px 1fr; gap: var(--space-4); }
    .escala-value { font-size: 38px; }
  }
  @media (max-width: 768px) {
    .page-title { font-size: 22px; line-height: 30px; }
    .workspace { grid-template-columns: 1fr; min-height: auto; }
    .sheet-list { max-height: 320px; overflow-y: auto; }
    .escala-grid { grid-template-columns: 1fr; }
    .titleblock-crop { max-width: 280px; }
    .ready-strip { flex-direction: column; align-items: flex-start; }
    .ready-strip .spacer { display: none; }
  }
</style>

<div class="screen-body">

  <div class="page-eyebrow">Etapa 4 de 8 · Preparação das pranchas</div>
  <h1 class="page-title">Como medir cada planta</h1>
  <p class="page-lead">Antes de contar, o airio precisa saber a <strong>escala</strong> de cada prancha e o que cada <strong>camada</strong> CAD representa (eletroduto, tomada, quadro…). Os padrões do seu histórico já vêm propostos — só confirma.</p>

  <!-- ready strip -->
  <div class="ready-strip" role="region" aria-label="Estado das pranchas">
    <div class="stat"><span class="v">7</span><span class="l">Pranchas</span></div>
    <span class="sep">·</span>
    <div class="stat"><span class="v is-ok">5</span><span class="l">Prontas</span></div>
    <span class="sep">·</span>
    <div class="stat"><span class="v is-warn">1</span><span class="l">Pra ajustar</span></div>
    <span class="sep">·</span>
    <div class="stat"><span class="v">1</span><span class="l">Pendente</span></div>
    <span class="spacer"></span>
    <button class="bulk-btn" type="button">
      <span class="icon" aria-hidden="true">⚡</span>
      Aceitar padrões nas 2 outras pranchas
    </button>
  </div>

  <!-- 2-pane workspace -->
  <div class="workspace">

    <!-- LEFT: sheet list -->
    <aside class="sheet-list" aria-label="Pranchas">
      <div class="sheet-list-header">
        <span>Pranchas</span>
        <span class="count">7</span>
      </div>

      <div class="sheet-row is-active" tabindex="0" role="button" aria-current="true">
        <div class="row-thumb"></div>
        <div class="row-meta">
          <span class="row-num">PE-ELE-FRC · 01/12</span>
          <span class="row-title">Planta de Força · Térreo</span>
          <span class="row-pavimento">1:50 · escala ✓ · 3 camadas pendentes</span>
        </div>
        <span class="row-status is-ajustes" title="3 camadas pendentes nesta prancha">!</span>
      </div>

      <div class="sheet-row" tabindex="0" role="button">
        <div class="row-thumb"></div>
        <div class="row-meta">
          <span class="row-num">PE-ELE-FRC · 02/12</span>
          <span class="row-title">Planta de Força · 1º Pav</span>
          <span class="row-pavimento">1:50 · 11 camadas</span>
        </div>
        <span class="row-status is-pronta" title="Pronta">✓</span>
      </div>

      <div class="sheet-row" tabindex="0" role="button">
        <div class="row-thumb"></div>
        <div class="row-meta">
          <span class="row-num">PE-ELE-FRC · 03/12</span>
          <span class="row-title">Planta de Força · 2º Pav</span>
          <span class="row-pavimento">1:50 · 11 camadas</span>
        </div>
        <span class="row-status is-pronta" title="Pronta">✓</span>
