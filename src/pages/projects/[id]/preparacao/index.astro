---
import ProjectLayout from '../../../../layouts/ProjectLayout.astro';
import PdfViewer from '../../../../components/PdfViewer.astro';
import ScaleInspectModal from '../../../../components/ScaleInspectModal.astro';
import { loadProject, loadSheetsForPhase } from '../../../../lib/projects';
import { getDb } from '../../../../lib/db';

const { id } = Astro.params;
const projectId = String(id ?? '');
const project = await loadProject(projectId);

if (!project) {
  return new Response('Project not found', { status: 404 });
}

const db = getDb();
// S4 + S6 work on plantas only. Quadros = S7, unifilares = post-MVP.
// loadSheetsForPhase excludes layers_json (the ~500kB BLOB) — this screen
// does not need the layer inventory; GET /layers fetches it lazily.
// Ignored sheets (soft-deleted via S3) are out of every downstream phase.
const allSheets = await loadSheetsForPhase(db, projectId, ['planta_forca', 'iluminacao']);
// loadSheetsForPhase does not sort — preserve original createdAt order.
allSheets.sort((a, b) => a.createdAt - b.createdAt);

const eligibleSheets = allSheets.filter((s) => s.ignored !== 1);

const KIND_LABEL: Record<string, { full: string; short: string }> = {
  planta_forca: { full: 'Planta de Força', short: 'FRC' },
  iluminacao: { full: 'Planta de Iluminação', short: 'ILU' },
};

interface SheetView {
  id: string;
  filename: string;
  pageIndex: number;
  kindFull: string;
  kindShort: string;
  scaleDenom: number | null;
  scaleSet: number;
  scaleSource: 'titleblock_text' | 'manual' | null;
  statusClass: 'is-pronta' | 'is-ajustes' | 'is-pendente';
  statusGlyph: string;
}

const sheetViews: SheetView[] = eligibleSheets.map((s) => {
  const kind = s.kind ?? 'planta_forca';
  const label = KIND_LABEL[kind] ?? { full: kind, short: kind.toUpperCase() };
  let statusClass: SheetView['statusClass'];
  let statusGlyph: string;
  if (s.scaleSet === 1 && s.scaleDenom != null) {
    statusClass = 'is-pronta';
    statusGlyph = '✓';
  } else {
    statusClass = 'is-pendente';
    statusGlyph = '·';
  }
  return {
    id: s.id,
    filename: s.filename ?? '(sem nome)',
    pageIndex: s.pageIndex ?? 0,
    kindFull: label.full,
    kindShort: label.short,
    scaleDenom: s.scaleDenom,
    scaleSet: s.scaleSet ?? 0,
    scaleSource: s.scaleSource,
    statusClass,
    statusGlyph,
  };
});

const totalSheets = sheetViews.length;
const readyCount = sheetViews.filter((s) => s.statusClass === 'is-pronta').length;
const pendingCount = totalSheets - readyCount;
const projectName = project.name;
---

<ProjectLayout
  title={`airio · Preparação · ${projectName}`}
  step={4}
  doneSteps={[1, 2, 3]}
  projectName={projectName}
  breadcrumbTail="Preparação"
  keymap={['⌘ + Enter · próxima prancha', '↑↓ · navegar lista', 'A · aceitar todas']}
  footerLeftText="Preparação salva automaticamente"
  contentMaxWidth={1440}
>

<style>
  /* ============ screen body ============ */
  .screen-body {
    width: 100%;
    padding-bottom: var(--space-12);
  }

  /* ============ page header ============ */
  .page-eyebrow {
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-2);
  }
  .page-title {
    font: 600 28px/36px var(--font-sans);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-2);
    color: var(--color-fg-primary);
  }
  .page-lead {
    font: 400 15px/22px var(--font-sans);
    color: var(--color-fg-secondary);
    margin: 0 0 var(--space-6);
    max-width: 78ch;
  }
  .page-lead strong { color: var(--color-fg-primary); font-weight: 600; }

  /* ============ ready strip ============ */
  .ready-strip {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .ready-strip .stat { display: flex; align-items: baseline; gap: var(--space-1); }
  .ready-strip .stat .v {
    font: 600 15px/20px var(--font-sans);
    color: var(--color-fg-primary);
    font-variant-numeric: tabular-nums;
  }
  .ready-strip .stat .v.is-ok { color: var(--color-success); }
  .ready-strip .stat .v.is-warn { color: var(--color-warning); }
  .ready-strip .stat .l { font: 500 11px/16px var(--font-sans); color: var(--color-fg-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .ready-strip .sep { color: var(--color-fg-disabled); }
  .ready-strip .spacer { flex: 1; }
  .ready-strip .bulk-btn {
    font: 500 13px/18px var(--font-sans);
    padding: 6px 12px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    color: var(--color-fg-primary);
    cursor: pointer;
    display: inline-flex; align-items: center; gap: var(--space-2);
  }
  .ready-strip .bulk-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .ready-strip .bulk-btn .icon { color: var(--color-accent); }

  /* ============ 2-pane workspace ============ */
  .workspace {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--space-4);
    min-height: 720px;
  }

  /* ============ left pane: sheet list ============ */
  .sheet-list {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex; flex-direction: column;
  }
  .sheet-list-header {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-default);
    background: var(--color-bg-surface);
    display: flex; align-items: center; justify-content: space-between;
    font: 500 11px/16px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-fg-muted);
  }
  .sheet-list-header .count { font-family: var(--font-mono); color: var(--color-fg-secondary); }

  .sheet-row {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    cursor: pointer;
    align-items: center;
    transition: background var(--motion-fast) var(--ease-default);
  }
  .sheet-row:hover { background: var(--color-bg-surface); }
  .sheet-row.is-active {
    background: var(--color-accent-soft-bg);
    border-left: 2px solid var(--color-accent);
    padding-left: calc(var(--space-4) - 2px);
  }
  .sheet-row.is-active .row-title { color: var(--color-fg-primary); }

  .row-thumb {
    width: 44px; height: 32px;
    background:
      repeating-linear-gradient(0deg, rgba(10,10,10,0.05) 0 1px, transparent 1px 6px),
      repeating-linear-gradient(90deg, rgba(10,10,10,0.05) 0 1px, transparent 1px 6px),
      var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xs);
    position: relative;
    overflow: hidden;
  }
  .row-thumb::after {
    content: '';
    position: absolute; left: 4px; right: 4px; top: 8px; bottom: 8px;
    border: 1px solid rgba(10,10,10,0.18);
  }
  .row-thumb.is-blank::after { display: none; }

  .row-meta { display: grid; gap: 2px; min-width: 0; }
  .row-num {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.02em;
    color: var(--color-fg-muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .row-title {
    font: 500 13px/18px var(--font-sans);
    color: var(--color-fg-secondary);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .row-pavimento {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-fg-muted);
  }

  .row-status {
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px;
    border-radius: 50%;
    font: 600 12px/1 var(--font-sans);
  }
  .row-status.is-pronta { background: var(--color-success-soft-bg); color: var(--color-success); }
  .row-status.is-ajustes { background: var(--color-warning-soft-bg); color: var(--color-warning); }
  .row-status.is-pendente { background: var(--color-bg-surface); color: var(--color-fg-disabled); border: 1px solid var(--color-border-default); }

  /* ============ right pane: active sheet ============ */
  .active-sheet {
    display: flex; flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .sheet-header {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) 0 var(--space-2);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .sheet-header h2 {
    font: 600 18px/24px var(--font-sans);
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-fg-primary);
  }
  .sheet-header .sheet-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg-muted);
    letter-spacing: 0.02em;
  }
  .sheet-header .sheet-pavimento {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg-secondary);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
  }

  /* ============ sub-panel base ============ */
  .sub-panel {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .sub-panel-head {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-default);
    background: var(--color-bg-surface);
  }
  .sub-panel-head h3 {
    font: 600 13px/18px var(--font-sans);
    margin: 0;
    color: var(--color-fg-primary);
    letter-spacing: -0.005em;
  }
  .sub-panel-head .hint {
    font: 400 12px/16px var(--font-sans);
    color: var(--color-fg-muted);
  }
  .sub-panel-body { padding: var(--space-4); }

  /* ============ escala panel ============ */
  .escala-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-6);
    align-items: center;
  }
  .titleblock-crop {
    position: relative;
    aspect-ratio: 11 / 7;
    background: var(--color-bg-app);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  /* Click target wrapping titleblock-crop. PDF preview + inspect hint stacked. */
  .titleblock-crop-trigger {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    width: 100%;
    cursor: zoom-in;
    display: grid;
    gap: 4px;
    text-align: left;
  }
  .titleblock-crop-trigger:hover .titleblock-crop {
    border-color: var(--color-accent);
  }
  .titleblock-inspect-hint {
    font: 400 11px/1.4 var(--font-mono, ui-monospace, monospace);
    color: var(--color-fg-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .titleblock-crop-trigger:hover .titleblock-inspect-hint {
    color: var(--color-accent);
  }
  .titleblock-crop .tb-grid {
    position: absolute; inset: 8px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-border-default);
  }
  .titleblock-crop .tb-cell {
    background: var(--color-bg-app);
    padding: 4px 6px;
    font-family: var(--font-mono);
    font-size: 8px;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    overflow: hidden;
  }
  .titleblock-crop .tb-cell strong {
    color: var(--color-fg-secondary); font-weight: 500; display: block; font-size: 7px; margin-bottom: 1px;
  }
  .titleblock-crop .tb-highlight {
    position: absolute;
    bottom: 18px; left: 8px;
    width: 102px; height: 18px;
    border: 1.5px solid var(--color-accent);
    border-radius: 2px;
    pointer-events: none;
    box-shadow: 0 0 0 3px var(--color-accent-soft-bg);
  }
  .titleblock-crop .tb-arrow {
    position: absolute;
    bottom: 4px; left: 8px;
    font-family: var(--font-mono);
    font-size: 8px;
    color: var(--color-accent);
    font-weight: 600;
  }

  .escala-read { display: grid; gap: var(--space-3); }
  .escala-value-row { display: flex; align-items: baseline; gap: var(--space-3); }
  .escala-value {
    font: 600 44px/1 var(--font-mono);
    letter-spacing: -0.02em;
    color: var(--color-fg-primary);
    font-variant-numeric: tabular-nums;
  }
  .escala-value .colon { color: var(--color-fg-muted); margin: 0 4px; font-weight: 400; }
  .escala-source-chip {
    display: inline-flex; align-items: center; gap: var(--space-1);
    padding: 3px 8px;
    background: var(--color-success-soft-bg);
    color: var(--color-success);
    font: 500 11px/16px var(--font-sans);
    border-radius: var(--radius-xs);
  }
  .escala-source-chip .src-mono {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-success);
    margin-left: var(--space-1);
    opacity: 0.85;
  }
  .escala-help { font: 400 13px/18px var(--font-sans); color: var(--color-fg-secondary); margin: 0; }
  .escala-actions { display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-1); }
  .escala-fallback {
    font: 400 12px/16px var(--font-sans);
    color: var(--color-fg-muted);
    margin-top: var(--space-1);
  }
  .escala-fallback a {
    color: var(--color-info);
    text-decoration: none;
    border-bottom: 1px dotted var(--color-info);
  }
  .escala-fallback a:hover { border-bottom-style: solid; }
  .escala-fallback .sep { color: var(--color-fg-disabled); margin: 0 var(--space-1); }

  /* ============ camadas panel ============ */
  /*
   * DESIGN.md orange-discipline:
   * - Bulk banner background: amber #fef3c7 / #92400e (NOT accent-soft-bg). Decorative tint = amber family.
   * - Bulk-accept CTA: accent (orange) — it's the action signal.
   * - Source badges: neutral greys only. NOT orange, NOT blue, NOT success-green decoratively.
   *   Histórico = dark-grey | Glossário = mid-grey | IA = light-grey | Confirmado = success-green
   * - Orange is only used for: .camadas-bulk-accept-btn, .kind-select:focus-visible ring.
   */
  .camadas-bulk {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: #fef3c7;  /* amber-100 — NOT accent-soft-bg; decorative emphasis = amber */
    border-bottom: 1px solid #fde68a;
  }
  .camadas-bulk-text {
    font: 500 13px/18px var(--font-sans);
    color: #92400e;  /* amber-800 */
  }
  .camadas-bulk-text strong { font-weight: 600; }
  /* .camadas-bulk-accept-btn inherits .btn .btn-primary (accent CTA — correct per spec) */

  /* Skeleton loading rows */
  .camadas-skel-row td { padding: 8px var(--space-4); border-bottom: 1px solid var(--color-border-subtle); }
  .skel-bar {
    display: inline-block;
    height: 12px;
    background: var(--color-border-subtle);
    border-radius: var(--radius-xs);
    animation: skel-pulse 1.4s ease-in-out infinite;
  }
  @keyframes skel-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }

  .camadas-table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .camadas-table thead th {
    text-align: left;
    font: 500 10px/14px var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
    background: var(--color-bg-surface);
    padding: 8px var(--space-4);
    border-bottom: 1px solid var(--color-border-default);
  }
  .camadas-table tbody td {
    padding: 8px var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    vertical-align: middle;
    font: 400 13px/18px var(--font-sans);
    color: var(--color-fg-primary);
  }
  .camadas-table tbody tr:hover { background: var(--color-bg-surface); }
  .camadas-table tbody tr:last-child td { border-bottom: none; }
  .camadas-table tbody tr.is-saving { opacity: 0.6; }
  .camadas-table tbody tr.is-error td:first-child { border-left: 2px solid var(--color-danger); }

  .layer-name {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg-primary);
  }
  .elem-count {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg-muted);
    font-variant-numeric: tabular-nums;
  }
  .kind-select {
    font: 500 12px/16px var(--font-sans);
    padding: 4px 8px;
    background: var(--color-bg-input);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xs);
    color: var(--color-fg-primary);
    min-width: 130px;
  }
  .kind-select:hover { border-color: var(--color-border-strong); }
  /* focus ring: accent (orange) — correct; this is a focus signal per DESIGN.md */
  .kind-select:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; border-color: var(--color-accent); }
  .kind-select:focus { outline: 2px solid var(--color-accent); outline-offset: 1px; border-color: var(--color-accent); }

  /*
   * Source badges — neutral greys per spec decision #8.
   * Histórico = dark-grey (#404040 on #f5f5f5)
   * Glossário  = mid-grey  (#737373 on #fafafa)
   * IA         = light-grey (#a3a3a3 on #fafafa border)
   * Confirmado = success-green (#16a34a on #f0fdf4) — earned status, not a source
   */
  .src-chip {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 2px 7px;
    font: 500 11px/16px var(--font-sans);
    border-radius: var(--radius-xs);
    white-space: nowrap;
  }
  .src-chip .pip { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
  /* Histórico: dark-grey — user has been here before; highest confidence signal */
  .src-chip.is-hist { background: #f5f5f5; color: #404040; border: 1px solid #e5e5e5; }
  .src-chip.is-hist .pip { background: #525252; }
  /* Glossário: mid-grey — encoded BR convention, reliable but not user-verified */
  .src-chip.is-glossary { background: #fafafa; color: #737373; border: 1px solid #e5e5e5; }
  .src-chip.is-glossary .pip { background: #a3a3a3; }
  /* IA: lightest grey — LLM proposal, lowest confidence; user must verify */
  .src-chip.is-intel { background: #fafafa; color: #a3a3a3; border: 1px solid #e5e5e5; }
  .src-chip.is-intel .pip { background: #d4d4d4; }
  /* Confirmado: success-green — user committed; stands alone from source provenance */
  .src-chip.is-confirmed { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
  .src-chip.is-confirmed .pip { background: #16a34a; }

  .action-cell { text-align: right; white-space: nowrap; }
  .save-spinner {
    display: inline-block;
    width: 14px; height: 14px;
    border: 2px solid var(--color-border-default);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
    vertical-align: middle;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .camadas-foot {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-surface);
    border-top: 1px solid var(--color-border-default);
    font: 400 12px/16px var(--font-sans);
    color: var(--color-fg-secondary);
  }
  .camadas-foot .counter { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .camadas-foot .counter .ok { color: #16a34a; font-weight: 500; }

  /* ============ form actions ============ */
  .form-actions {
    display: flex; justify-content: space-between; align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
  }
  .form-meta { font: 400 12px/16px var(--font-sans); color: var(--color-fg-muted); }
  .form-actions .btn-group { display: flex; gap: var(--space-2); }

  .btn {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font: 500 13px/18px var(--font-sans);
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition: background var(--motion-fast) var(--ease-default), border-color var(--motion-fast) var(--ease-default);
  }
  .btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .btn-primary { background: var(--color-accent); color: #fff; text-decoration: none; }
  .btn-primary:hover { background: var(--color-accent-hover); }
  .btn-primary.is-disabled,
  .btn-primary:disabled { background: var(--color-bg-disabled); color: var(--color-fg-disabled); cursor: not-allowed; }
  .btn-secondary { background: var(--color-bg-elevated); color: var(--color-fg-primary); border-color: var(--color-border-default); text-decoration: none; }
  .btn-secondary:hover { background: var(--color-bg-surface); border-color: var(--color-border-strong); }
  .btn-ghost { background: transparent; color: var(--color-fg-secondary); text-decoration: none; }
  .btn-ghost:hover { background: var(--color-bg-surface); color: var(--color-fg-primary); }

  /* ============ responsive ============ */
  @media (max-width: 1024px) {
    .workspace { grid-template-columns: 280px 1fr; }
    .escala-grid { grid-template-columns: 180px 1fr; gap: var(--space-4); }
    .escala-value { font-size: 38px; }
  }
  @media (max-width: 768px) {
    .page-title { font-size: 22px; line-height: 30px; }
    .workspace { grid-template-columns: 1fr; min-height: auto; }
    .sheet-list { max-height: 320px; overflow-y: auto; }
    .escala-grid { grid-template-columns: 1fr; }
    .titleblock-crop { max-width: 280px; }
    .ready-strip { flex-direction: column; align-items: flex-start; }
    .ready-strip .spacer { display: none; }
  }
</style>

<div class="screen-body">

  <div class="page-eyebrow">Etapa 4 de 8 · Preparação das pranchas</div>
  <h1 class="page-title">Como medir cada planta</h1>
  <p class="page-lead">Antes de contar, o airio precisa saber a <strong>escala</strong> de cada prancha e o que cada <strong>camada</strong> CAD representa (eletroduto, tomada, quadro…). Os padrões do seu histórico já vêm propostos — só confirma.</p>

  <!-- ready strip — REAL counts from D1 (scale_set drives ready/pendente) -->
  <div class="ready-strip" role="region" aria-label="Estado das pranchas">
    <div class="stat"><span class="v">{totalSheets}</span><span class="l">Pranchas</span></div>
    <span class="sep">·</span>
    <div class="stat"><span class="v is-ok" data-ready-count>{readyCount}</span><span class="l">Com escala</span></div>
    <span class="sep">·</span>
    <div class="stat"><span class="v" data-pending-count>{pendingCount}</span><span class="l">Sem escala</span></div>
    <span class="spacer"></span>
  </div>

  <!-- 2-pane workspace -->
  <div class="workspace">

    <!-- LEFT: sheet list — dynamic from D1 (plantas only, non-ignored) -->
    <aside class="sheet-list" aria-label="Pranchas">
      <div class="sheet-list-header">
        <span>Pranchas</span>
        <span class="count">{totalSheets}</span>
      </div>

      {totalSheets === 0 && (
        <div style="padding: var(--space-4); font: 400 13px/18px var(--font-sans); color: var(--color-fg-muted);">
          Nenhuma planta elegível. Volte à <a href={`/projects/${projectId}/triagem`}>Triagem</a> para classificar as pranchas.
        </div>
      )}

      {sheetViews.map((s, idx) => (
        <div
          class:list={['sheet-row', idx === 0 && 'is-active']}
          tabindex="0"
          role="button"
          data-sheet-id={s.id}
          data-sheet-filename={s.filename}
          data-sheet-page={s.pageIndex}
          data-sheet-kind-full={s.kindFull}
          data-sheet-kind-short={s.kindShort}
          data-sheet-scale-denom={s.scaleDenom ?? ''}
          data-sheet-scale-set={s.scaleSet}
          data-sheet-scale-source={s.scaleSource ?? ''}
          aria-current={idx === 0 ? 'true' : undefined}
        >
          <div class="row-thumb"></div>
          <div class="row-meta">
            <span class="row-num">{s.kindShort} · {s.filename}</span>
            <span class="row-title">{s.kindFull}</span>
            <span class="row-pavimento" data-row-pavimento>
              {s.scaleSet === 1 && s.scaleDenom != null ? `1:${s.scaleDenom} · escala ✓` : 'sem escala'}
            </span>
          </div>
          <span
            class:list={['row-status', s.statusClass]}
            data-row-status
            title={s.statusClass === 'is-pronta' ? 'Escala definida' : 'Pendente'}
          >
            {s.statusGlyph}
          </span>
        </div>
      ))}
    </aside>

    <!-- RIGHT: active sheet workspace -->
    <section class="active-sheet" aria-label="Prancha ativa">

      <div class="sheet-header" data-active-sheet-header>
        <div>
          <span class="sheet-num" data-active-sheet-num>{sheetViews[0]?.filename ?? '—'}</span>
          <h2 data-active-sheet-title>{sheetViews[0]?.kindFull ?? 'Nenhuma planta'}</h2>
        </div>
        <span class="sheet-pavimento" data-active-sheet-pavimento>página {(sheetViews[0]?.pageIndex ?? 0) + 1}</span>
      </div>

      <!-- Escala sub-panel — WIRED to /api/projects/[id]/sheets/[sheet_id]/scale -->
      <div class="sub-panel" aria-label="Escala da prancha" data-escala-panel data-project-id={projectId}>
        <header class="sub-panel-head">
          <h3>Escala</h3>
          <span class="hint" data-escala-hint>Lida do carimbo automaticamente</span>
        </header>
        <div class="sub-panel-body">
          <div class="escala-grid">

            <!-- left: real PDF crop showing bottom-right titleblock (BR convention).
                 Click → opens ScaleInspectModal for full-page zoom + pan + cross-sheet compare. -->
            {sheetViews[0] && (
              <button
                type="button"
                class="titleblock-crop-trigger"
                data-titleblock-trigger
                data-sheet-id={sheetViews[0].id}
                data-sheet-filename={sheetViews[0].filename}
                data-sheet-page={sheetViews[0].pageIndex}
                aria-label="Inspecionar prancha"
              >
                <PdfViewer
                  pdfUrl={`/api/projects/${projectId}/sheets/${sheetViews[0].id}/pdf`}
                  pageIndex={sheetViews[0].pageIndex}
                  mode="titleblock-crop"
                  scale={1.2}
                  class="titleblock-crop"
                  ariaLabel="Carimbo da prancha"
                />
                <span class="titleblock-inspect-hint">Inspecionar prancha →</span>
              </button>
            )}

            <!-- right: read-out — JS swaps content based on active sheet + last fetch -->
            <div class="escala-read">
              <div class="escala-value-row">
                <span class="escala-value" data-escala-value>—</span>
                <span class="escala-source-chip" data-escala-source style="display:none"></span>
              </div>
              <p class="escala-help" data-escala-help>
                1 cm desenhado = N cm reais. Vale pra <strong>todas as medidas</strong> que o airio puxar desta prancha (eletroduto, eletrocalha, distância entre tomadas).
              </p>

              <div class="escala-actions" data-escala-actions>
                <button type="button" class="btn btn-primary" data-escala-action="extract">Extrair do carimbo</button>
                <button type="button" class="btn btn-ghost" data-escala-action="manual-open">Definir manualmente</button>
              </div>

              <div class="escala-actions" data-escala-manual-row style="display:none">
                <label style="font: 400 13px/18px var(--font-sans); color: var(--color-fg-secondary);">
                  Escala 1:
                  <input type="number" min="1" max="5000" step="1" data-escala-manual-input
                    style="font-family: var(--font-mono); font-size: 14px; width: 80px; padding: 4px 8px; border: 1px solid var(--color-border-default); border-radius: var(--radius-xs); background: var(--color-bg-input);" />
                </label>
                <button type="button" class="btn btn-primary" data-escala-action="manual-save">Salvar</button>
                <button type="button" class="btn btn-ghost" data-escala-action="manual-cancel">Cancelar</button>
              </div>

              <p class="escala-fallback" data-escala-fallback style="display:none">
                Carimbo não tinha escala legível. <a href="#" data-escala-action="manual-open">Definir manualmente</a>.
              </p>

              <p data-escala-error class="escala-fallback" style="display:none; color: var(--color-danger);"></p>
            </div>

          </div>
        </div>
      </div>

      <!-- Camadas sub-panel — WIRED to /api/projects/[id]/sheets/[sheet_id]/layers -->
      <div class="sub-panel" id="camadas-panel" aria-label="Camadas CAD da prancha" data-project-id={projectId}>
        <header class="sub-panel-head">
          <h3>Camadas CAD <span class="hint" style="font-weight: 400; margin-left: var(--space-2);">o que cada camada vira no orçamento</span></h3>
          <span class="hint" id="camadas-layer-count">—</span>
        </header>

        <!-- Intel-fired indicator — shown only when intel_called=true and ≥1 source='intel' -->
        <p id="camadas-intel-note" style="display:none; font: 400 12px/16px var(--font-sans); color: var(--color-fg-muted); margin: 0 0 var(--space-3);">
          Propostas geradas com IA para <strong id="camadas-intel-count">N</strong> camadas. Confirme cada uma.
        </p>

        <!-- Bulk-accept — shown only when ≥1 cross_project proposal exists -->
        <div id="camadas-bulk" class="camadas-bulk" style="display:none">
          <span class="camadas-bulk-text" id="camadas-bulk-text"></span>
          <button type="button" id="camadas-bulk-btn" class="btn btn-primary camadas-bulk-accept-btn">Aceitar com histórico</button>
        </div>

        <!-- Loading skeleton — 9 grey rows while GET is in flight -->
        <div id="camadas-skeleton">
          <table class="camadas-table" aria-hidden="true">
            <thead>
              <tr>
                <th style="width: 28%;">Camada</th>
                <th style="width: 24%;">Vira no orçamento</th>
                <th style="width: 28%;">De onde veio a proposta</th>
                <th style="width: 8%;">Elem.</th>
                <th style="width: 12%;"></th>
              </tr>
            </thead>
            <tbody id="camadas-skeleton-rows">
              {Array.from({ length: 9 }).map(() => (
                <tr class="camadas-skel-row">
                  <td><span class="skel-bar" style="width: 80%;"></span></td>
                  <td><span class="skel-bar" style="width: 70%;"></span></td>
                  <td><span class="skel-bar" style="width: 55%;"></span></td>
                  <td><span class="skel-bar" style="width: 40%;"></span></td>
                  <td></td>
                </tr>
              ))}
            </tbody>
          </table>
          <p style="font: 400 12px/16px var(--font-sans); color: var(--color-fg-muted); margin: var(--space-2) 0 0;">Lendo camadas da prancha…</p>
        </div>

        <!-- Real table — hidden until data loads -->
        <div id="camadas-loaded" style="display:none">
          <table class="camadas-table" aria-label="Camadas CAD e seus tipos">
            <thead>
              <tr>
                <th style="width: 28%;">Camada</th>
                <th style="width: 24%;">Vira no orçamento</th>
                <th style="width: 28%;">De onde veio a proposta</th>
                <th style="width: 8%;">Elem.</th>
                <th style="width: 12%;"></th>
              </tr>
            </thead>
            <tbody id="camadas-tbody">
              <!-- rows injected by JS -->
            </tbody>
          </table>

          <!-- Disclosure link for hidden (non-elétrica) layers -->
          <div id="camadas-hidden-row" style="display:none; margin-top: var(--space-3);">
            <button type="button" id="camadas-show-hidden" class="btn btn-ghost" style="font-size: 12px; padding: var(--space-1) var(--space-2);">
              Mostrar todas as <span id="camadas-total-count">99</span> camadas (<span id="camadas-hidden-count">75</span> ocultas pelo filtro)
            </button>
          </div>

          <div class="camadas-foot">
            <span class="counter">
              <span class="ok" id="camadas-confirmed-count">0</span> de <span id="camadas-total-visible">0</span> confirmadas
            </span>
            <span>O que você confirmar aqui melhora a proposta no próximo projeto.</span>
          </div>
        </div>

        <!-- Error state -->
        <p id="camadas-error" style="display:none; font: 400 13px/18px var(--font-sans); color: var(--color-danger); margin: var(--space-3) 0 0;"></p>
      </div>

      <!-- Hidden-layers modal (native dialog) -->
      <dialog id="camadas-hidden-modal" style="
        border: 1px solid var(--color-border-default);
        border-radius: var(--radius-sm);
        padding: 0;
        max-width: 560px;
        width: 90vw;
        max-height: 80vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      ">
        <div style="
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: var(--space-4) var(--space-5);
          border-bottom: 1px solid var(--color-border-subtle);
        ">
          <h3 style="font: 600 15px/22px var(--font-sans); color: var(--color-fg-primary); margin: 0;">
            Camadas ocultas pelo filtro elétrica
          </h3>
          <button type="button" id="camadas-modal-close" style="
            background: none; border: none; cursor: pointer;
            font-size: 18px; line-height: 1; color: var(--color-fg-muted);
            padding: 0 var(--space-1);
          " aria-label="Fechar">×</button>
        </div>
        <p style="padding: var(--space-3) var(--space-5) 0; font: 400 12px/16px var(--font-sans); color: var(--color-fg-muted); margin: 0;">
          Estas camadas não têm prefixo elétrica e não aparecem na tabela principal. Apenas para verificação — não há ação disponível aqui.
        </p>
        <div style="overflow-y: auto; padding: var(--space-3) var(--space-5) var(--space-5);">
          <ul id="camadas-hidden-list" style="list-style: none; margin: 0; padding: 0; font-family: var(--font-mono); font-size: 12px; color: var(--color-fg-secondary);">
            <!-- injected by JS -->
          </ul>
        </div>
      </dialog>

    </section>

  </div>

  <!-- form actions -->
  <div class="form-actions">
    <span class="form-meta">Preparação salva automaticamente · <span class="mono">há 4s</span></span>
    <div class="btn-group">
      <a class="btn btn-ghost" href={`/projects/${id}/triagem`}>← Triagem</a>
      <a class="btn btn-primary" href={`/projects/${id}/preparacao/legenda`}>Próximo · Legenda →</a>
    </div>
  </div>

</div>

<ScaleInspectModal projectId={projectId} sheets={sheetViews.map((s) => ({ id: s.id, filename: s.filename, pageIndex: s.pageIndex, kindShort: s.kindShort }))} />

</ProjectLayout>

<script is:inline define:vars={{ projectId }}>
  // ===== sheet row activation + Escala panel state =====
  (function () {
    const rows = document.querySelectorAll('.sheet-row');
    const panel = document.querySelector('[data-escala-panel]');
    if (!panel) return;

    const els = {
      value: panel.querySelector('[data-escala-value]'),
      source: panel.querySelector('[data-escala-source]'),
      hint: panel.querySelector('[data-escala-hint]'),
      help: panel.querySelector('[data-escala-help]'),
      actions: panel.querySelector('[data-escala-actions]'),
      manualRow: panel.querySelector('[data-escala-manual-row]'),
      manualInput: panel.querySelector('[data-escala-manual-input]'),
      fallback: panel.querySelector('[data-escala-fallback]'),
      error: panel.querySelector('[data-escala-error]'),
      tbEsc: panel.querySelector('[data-tb-esc]'),
      tbPag: panel.querySelector('[data-tb-pag]'),
      tbPranchanum: panel.querySelector('[data-tb-pranchanum]'),
    };
    const headerNum = document.querySelector('[data-active-sheet-num]');
    const headerTitle = document.querySelector('[data-active-sheet-title]');
    const headerPav = document.querySelector('[data-active-sheet-pavimento]');
    const readyCountEl = document.querySelector('[data-ready-count]');
    const pendingCountEl = document.querySelector('[data-pending-count]');

    function activeRow() {
      return document.querySelector('.sheet-row.is-active');
    }

    function recalcCounts() {
      let ready = 0;
      document.querySelectorAll('.sheet-row').forEach(function (r) {
        if (r.getAttribute('data-sheet-scale-set') === '1') ready += 1;
      });
      const total = document.querySelectorAll('.sheet-row').length;
      if (readyCountEl) readyCountEl.textContent = String(ready);
      if (pendingCountEl) pendingCountEl.textContent = String(total - ready);
    }

    function renderPanel(row) {
      els.error.style.display = 'none';
      els.error.textContent = '';
      els.manualRow.style.display = 'none';
      els.actions.style.display = '';
      els.fallback.style.display = 'none';

      if (!row) {
        els.value.textContent = '—';
        els.source.style.display = 'none';
        if (headerNum) headerNum.textContent = '—';
        if (headerTitle) headerTitle.textContent = 'Nenhuma planta';
        if (headerPav) headerPav.textContent = '';
        return;
      }

      const denomRaw = row.getAttribute('data-sheet-scale-denom');
      const denom = denomRaw && denomRaw !== '' ? parseInt(denomRaw, 10) : null;
      const set = row.getAttribute('data-sheet-scale-set') === '1';
      const filename = row.getAttribute('data-sheet-filename') || '—';
      const page = parseInt(row.getAttribute('data-sheet-page') || '0', 10);
      const kindFull = row.getAttribute('data-sheet-kind-full') || '—';
      const kindShort = row.getAttribute('data-sheet-kind-short') || '';

      if (headerNum) headerNum.textContent = kindShort + ' · ' + filename;
      if (headerTitle) headerTitle.textContent = kindFull;
      if (headerPav) headerPav.textContent = 'página ' + (page + 1);
      if (els.tbPranchanum) els.tbPranchanum.textContent = filename;
      if (els.tbPag) els.tbPag.textContent = String(page + 1);

      if (set && denom != null) {
        els.value.innerHTML = '1<span class="colon">:</span>' + denom;
        els.source.style.display = '';
        const src = row.getAttribute('data-sheet-scale-source') || '';
        if (src === 'manual') {
          els.source.textContent = 'Definida manualmente';
        } else if (src === 'titleblock_text') {
          els.source.textContent = 'Lida do carimbo';
        } else {
          els.source.textContent = 'Escala salva';
        }
        els.help.innerHTML = '1 cm desenhado = ' + denom + ' cm reais. Vale pra <strong>todas as medidas</strong> que o airio puxar desta prancha.';
        if (els.tbEsc) els.tbEsc.textContent = '1:' + denom;
      } else {
        els.value.textContent = '—';
        els.source.style.display = 'none';
        els.help.textContent = 'Escala não definida. Clique em “Extrair do carimbo” pra ler do PDF, ou “Definir manualmente”.';
        if (els.tbEsc) els.tbEsc.textContent = '—';
      }
    }

    function selectRow(row) {
      rows.forEach(function (r) { r.classList.remove('is-active'); r.removeAttribute('aria-current'); });
      row.classList.add('is-active');
      row.setAttribute('aria-current', 'true');
      renderPanel(row);
    }

    rows.forEach(function (row) {
      row.addEventListener('click', function () { selectRow(row); });
      row.addEventListener('keydown', function (ev) {
        if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); selectRow(row); }
      });
    });

    // ===== POST handlers =====
    async function postScale(sheetId, body) {
      const sessionId = (function () {
        try {
          let s = localStorage.getItem('airio_session');
          if (!s) { s = 'web-' + Math.random().toString(36).slice(2) + Date.now().toString(36); localStorage.setItem('airio_session', s); }
          return s;
        } catch (_e) { return 'web-anon'; }
      })();
      const resp = await fetch(
        '/api/projects/' + projectId + '/sheets/' + sheetId + '/scale',
        {
          method: 'POST',
          headers: { 'content-type': 'application/json', 'x-airio-session': sessionId },
          body: JSON.stringify(body || {}),
        },
      );
      const data = await resp.json().catch(function () { return null; });
      if (!resp.ok) {
        const msg = (data && (data.message || data.error)) || ('HTTP ' + resp.status);
        throw new Error(msg);
      }
      return data;
    }

    function applyResultToRow(row, data) {
      const sheet = data && data.sheet;
      const extraction = data && data.extraction;
      if (!sheet) return;
      const denom = sheet.scaleDenom != null ? Number(sheet.scaleDenom) : null;
      const set = sheet.scaleSet === 1 || sheet.scaleSet === '1';

      row.setAttribute('data-sheet-scale-denom', denom != null ? String(denom) : '');
      row.setAttribute('data-sheet-scale-set', set ? '1' : '0');
      if (extraction && extraction.source && extraction.source !== 'not_found') {
        row.setAttribute('data-sheet-scale-source', extraction.source);
      } else if (extraction && extraction.source === 'not_found') {
        row.setAttribute('data-sheet-scale-source', '');
      }
      const pav = row.querySelector('[data-row-pavimento]');
      const status = row.querySelector('[data-row-status]');
      if (pav) pav.textContent = (set && denom != null) ? ('1:' + denom + ' · escala ✓') : 'sem escala';
      if (status) {
        status.classList.remove('is-pronta', 'is-ajustes', 'is-pendente');
        if (set && denom != null) {
          status.classList.add('is-pronta');
          status.textContent = '✓';
          status.title = 'Escala definida';
        } else {
          status.classList.add('is-pendente');
          status.textContent = '·';
          status.title = 'Pendente';
        }
      }
      recalcCounts();
      renderPanel(row);
    }

    function setBusy(busy, label) {
      const btns = panel.querySelectorAll('button[data-escala-action]');
      btns.forEach(function (b) { b.disabled = !!busy; });
      if (busy && label && els.hint) els.hint.textContent = label;
      else if (els.hint) els.hint.textContent = 'Lida do carimbo automaticamente';
    }

    function showError(message) {
      els.error.style.display = '';
      els.error.textContent = message;
    }

    panel.addEventListener('click', async function (ev) {
      const target = ev.target;
      if (!(target instanceof Element)) return;
      const actionEl = target.closest('[data-escala-action]');
      if (!actionEl) return;
      ev.preventDefault();
      const action = actionEl.getAttribute('data-escala-action');
      const row = activeRow();
      if (!row) return;
      const sheetId = row.getAttribute('data-sheet-id');
      if (!sheetId) return;

      if (action === 'manual-open') {
        els.actions.style.display = 'none';
        els.manualRow.style.display = '';
        els.fallback.style.display = 'none';
        els.error.style.display = 'none';
        const cur = row.getAttribute('data-sheet-scale-denom');
        if (cur && els.manualInput) els.manualInput.value = cur;
        if (els.manualInput) els.manualInput.focus();
        return;
      }
      if (action === 'manual-cancel') {
        els.manualRow.style.display = 'none';
        els.actions.style.display = '';
        return;
      }
      if (action === 'manual-save') {
        const v = parseInt((els.manualInput && els.manualInput.value) || '', 10);
        if (!Number.isInteger(v) || v < 1 || v > 5000) {
          showError('Escala 1:N deve ser inteiro entre 1 e 5000.');
          return;
        }
        try {
          setBusy(true, 'Salvando…');
          const data = await postScale(sheetId, { scale_denom: v });
          applyResultToRow(row, data);
          els.manualRow.style.display = 'none';
          els.actions.style.display = '';
        } catch (err) {
          showError('Falha ao salvar: ' + (err && err.message ? err.message : 'erro desconhecido'));
        } finally {
          setBusy(false);
        }
        return;
      }
      if (action === 'extract') {
        try {
          setBusy(true, 'Lendo carimbo (até ~6s na 1ª chamada)…');
          const data = await postScale(sheetId, {});
          applyResultToRow(row, data);
          if (data && data.extraction && data.extraction.source === 'not_found') {
            els.fallback.style.display = '';
            // Auto-open inspect modal — user needs to SEE the carimbo to figure
            // out the scale before clicking "Definir manualmente".
            openInspect(row);
          }
        } catch (err) {
          showError('Falha ao extrair: ' + (err && err.message ? err.message : 'erro desconhecido'));
          // 5xx / network: same blind-user gap as not_found → open inspect.
          openInspect(row);
        } finally {
          setBusy(false);
        }
        return;
      }
    });

    // ===== Inspect modal trigger =====
    // Click on the titleblock-crop button OR auto-open from extract failure.
    function openInspect(row) {
      const r = row || activeRow();
      if (!r) return;
      const sheetId = r.getAttribute('data-sheet-id') || '';
      const filename = r.getAttribute('data-sheet-filename') || '';
      const pageIndex = Number(r.getAttribute('data-sheet-page') || '0');
      document.dispatchEvent(new CustomEvent('scaleinspect:open', {
        detail: { sheetId: sheetId, filename: filename, pageIndex: pageIndex },
      }));
    }
    document.querySelectorAll('[data-titleblock-trigger]').forEach(function (btn) {
      btn.addEventListener('click', function (ev) {
        ev.preventDefault();
        const sheetId = btn.getAttribute('data-sheet-id') || '';
        const filename = btn.getAttribute('data-sheet-filename') || '';
        const pageIndex = Number(btn.getAttribute('data-sheet-page') || '0');
        document.dispatchEvent(new CustomEvent('scaleinspect:open', {
          detail: { sheetId: sheetId, filename: filename, pageIndex: pageIndex },
        }));
      });
    });

    // initial render: first row already has .is-active, render its panel.
    const initial = activeRow();
    if (initial) renderPanel(initial);
    else renderPanel(null);
    recalcCounts();
  })();

  // ===== Camadas panel — wired to GET /api/projects/[id]/sheets/[sheet_id]/layers =====
  // and POST /api/projects/[id]/sheets/[sheet_id]/layer-mappings
  (function () {
    // Hardcoded kind options (spec §2 — do NOT fetch from server)
    var KIND_OPTIONS = [
      { value: '',             label: '—' },
      { value: 'eletrocalha', label: 'Eletrocalha' },
      { value: 'perfilado',   label: 'Perfilado' },
      { value: 'leito',       label: 'Leito' },
      { value: 'barramento',  label: 'Barramento' },
      { value: 'eletroduto',  label: 'Eletroduto' },
    ];

    var panel       = document.getElementById('camadas-panel');
    var skeleton    = document.getElementById('camadas-skeleton');
    var loaded      = document.getElementById('camadas-loaded');
    var tbody       = document.getElementById('camadas-tbody');
    var errEl       = document.getElementById('camadas-error');
    var intelNote   = document.getElementById('camadas-intel-note');
    var intelCount  = document.getElementById('camadas-intel-count');
    var bulkEl      = document.getElementById('camadas-bulk');
    var bulkText    = document.getElementById('camadas-bulk-text');
    var bulkBtn     = document.getElementById('camadas-bulk-btn');
    var layerCountEl= document.getElementById('camadas-layer-count');
    var hiddenRow   = document.getElementById('camadas-hidden-row');
    var showHiddenBtn = document.getElementById('camadas-show-hidden');
    var totalCountEl  = document.getElementById('camadas-total-count');
    var hiddenCountEl = document.getElementById('camadas-hidden-count');
    var confirmedEl   = document.getElementById('camadas-confirmed-count');
    var totalVisEl    = document.getElementById('camadas-total-visible');
    var modal         = document.getElementById('camadas-hidden-modal');
    var modalClose    = document.getElementById('camadas-modal-close');
    var hiddenList    = document.getElementById('camadas-hidden-list');

    if (!panel || !skeleton || !loaded || !tbody) return;

    var pId = panel.getAttribute('data-project-id') || '';
    // Track confirmed rows and stored data
    var confirmedNames = new Set();
    var hiddenLayersData = [];

    // ---- source badge HTML ----
    function sourceBadge(source, isConfirmed) {
      if (isConfirmed) {
        return '<span class="src-chip is-confirmed"><span class="pip"></span>Confirmado</span>';
      }
      if (source === 'cross_project') {
        return '<span class="src-chip is-hist"><span class="pip"></span>Histórico</span>';
      }
      if (source === 'glossary') {
        return '<span class="src-chip is-glossary"><span class="pip"></span>Glossário</span>';
      }
      if (source === 'intel') {
        return '<span class="src-chip is-intel"><span class="pip"></span>IA</span>';
      }
      return '<span class="src-chip is-glossary"><span class="pip"></span>—</span>';
    }

    // ---- build kind <select> ----
    function kindSelect(layerName, currentKind) {
      var safeLayer = layerName.replace(/"/g, '&quot;');
      var html = '<select class="kind-select" data-layer="' + safeLayer + '" aria-label="Tipo da camada ' + safeLayer + '">';
      KIND_OPTIONS.forEach(function (opt) {
        var sel = (opt.value === (currentKind || '')) ? ' selected' : '';
        html += '<option value="' + opt.value + '"' + sel + '>' + opt.label + '</option>';
      });
      html += '</select>';
      return html;
    }

    // ---- render one row ----
    function buildRow(proposal) {
      var tr = document.createElement('tr');
      tr.setAttribute('data-layer-name', proposal.layer_name);
      tr.setAttribute('data-layer-source', proposal.source || '');

      // Treat any proposal that already has a non-null kind as "Confirmado" on initial load.
      // The server returns the persisted kind from layer_mappings on subsequent page loads,
      // so `kind != null` is the proxy for "user already confirmed this" until Wave 2a
      // adds an explicit confirmed_at field to the GET response.
      if (proposal.kind != null && proposal.kind !== '') {
        confirmedNames.add(proposal.layer_name);
      }
      var isConfirmed = confirmedNames.has(proposal.layer_name);

      var elemHint = proposal.element_count != null
        ? String(proposal.element_count)
        : '—';

      tr.innerHTML =
        '<td><span class="layer-name">' + proposal.layer_name + '</span></td>' +
        '<td>' + kindSelect(proposal.layer_name, proposal.kind) + '</td>' +
        '<td data-badge-cell>' + sourceBadge(proposal.source, isConfirmed) + '</td>' +
        '<td class="elem-count">' + elemHint + '</td>' +
        '<td class="action-cell" data-action-cell>' +
          (isConfirmed
            ? '<span style="font: 500 11px/16px var(--font-sans); color: #16a34a;">✓</span>'
            : '') +
        '</td>';

      return tr;
    }

    // ---- update footer counts ----
    function recalcConfirmed() {
      var rows = tbody.querySelectorAll('tr');
      var total = rows.length;
      var conf = confirmedNames.size;
      if (confirmedEl) confirmedEl.textContent = String(conf);
      if (totalVisEl) totalVisEl.textContent = String(total);
    }

    // ---- mark row as confirmed visually ----
    function markRowConfirmed(tr) {
      var layerName = tr.getAttribute('data-layer-name');
      if (layerName) confirmedNames.add(layerName);
      var badgeCell = tr.querySelector('[data-badge-cell]');
      var actionCell = tr.querySelector('[data-action-cell]');
      if (badgeCell) badgeCell.innerHTML = sourceBadge('', true);
      if (actionCell) actionCell.innerHTML = '<span style="font: 500 11px/16px var(--font-sans); color: #16a34a;">✓</span>';
      recalcConfirmed();
    }

    // ---- POST layer-mappings ----
    async function postMapping(sheetId, mapping) {
      var url = '/api/projects/' + pId + '/sheets/' + sheetId + '/layer-mappings';
      var res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mappings: [mapping] }),
      });
      if (!res.ok) {
        var text = await res.text();
        throw new Error(res.status + ': ' + text.slice(0, 120));
      }
      return res.json();
    }

    // ---- per-row dropdown change handler ----
    function wireDropdown(tr, sheetId) {
      var sel = tr.querySelector('select.kind-select');
      if (!sel) return;
      sel.addEventListener('change', async function () {
        var layerName = tr.getAttribute('data-layer-name');
        var source = tr.getAttribute('data-layer-source') || 'manual';
        var kind = sel.value || null;
        tr.classList.add('is-saving');
        var actionCell = tr.querySelector('[data-action-cell]');
        if (actionCell) actionCell.innerHTML = '<span class="save-spinner" aria-label="Salvando…"></span>';

        try {
          await postMapping(sheetId, { layer_name: layerName, kind: kind, source: source });
          tr.classList.remove('is-saving', 'is-error');
          markRowConfirmed(tr);
        } catch (err) {
          tr.classList.remove('is-saving');
          tr.classList.add('is-error');
          if (actionCell) actionCell.innerHTML = '<span style="color: var(--color-danger); font-size: 11px;" title="' + String(err.message || 'erro').replace(/"/g, '&quot;') + '">Erro</span>';
          // Revert select after 4s so user can retry
          setTimeout(function () {
            tr.classList.remove('is-error');
            if (actionCell) actionCell.innerHTML = '';
          }, 4000);
        }
      });
    }

    // ---- fetch layers for given sheet ----
    async function fetchLayers(sheetId) {
      skeleton.style.display = '';
      loaded.style.display = 'none';
      errEl.style.display = 'none';
      bulkEl.style.display = 'none';
      intelNote.style.display = 'none';
      hiddenRow.style.display = 'none';
      if (layerCountEl) layerCountEl.textContent = '—';

      try {
        var url = '/api/projects/' + pId + '/sheets/' + sheetId + '/layers';
        var res = await fetch(url);
        if (!res.ok) {
          var text = await res.text();
          throw new Error(res.status + ': ' + text.slice(0, 120));
        }
        var data = await res.json();

        // ---- intel-fired note ----
        var intelProposals = (data.proposals || []).filter(function (p) { return p.source === 'intel'; });
        if (data.intel_called && intelProposals.length > 0) {
          if (intelCount) intelCount.textContent = String(intelProposals.length);
          intelNote.style.display = '';
        }

        // ---- bulk-accept for cross_project proposals ----
        var histProposals = (data.proposals || []).filter(function (p) { return p.source === 'cross_project'; });
        if (histProposals.length > 0) {
          if (bulkText) bulkText.innerHTML = '<strong>' + histProposals.length + ' camadas</strong> com histórico de projetos anteriores. Aceitar todas de uma vez?';
          if (bulkBtn) bulkBtn.textContent = 'Aceitar ' + histProposals.length + ' com histórico';
          bulkEl.style.display = '';

          // Bulk-accept handler — wired here after we have sheetId in scope
          bulkBtn.onclick = async function () {
            bulkBtn.disabled = true;
            var mappings = histProposals.map(function (p) {
              return { layer_name: p.layer_name, kind: p.kind, source: p.source };
            });
            for (var i = 0; i < mappings.length; i++) {
              try { await postMapping(sheetId, mappings[i]); } catch (_) { /* swallow; row will show error on individual try */ }
              confirmedNames.add(mappings[i].layer_name);
            }
            // Refresh badges in DOM
            tbody.querySelectorAll('tr').forEach(function (tr) {
              var ln = tr.getAttribute('data-layer-name');
              if (ln && confirmedNames.has(ln)) markRowConfirmed(tr);
            });
            bulkBtn.textContent = '✓ Aceitas';
            bulkBtn.style.background = '#16a34a';
            bulkBtn.style.borderColor = '#16a34a';
          };
        }

        // ---- render rows ----
        tbody.innerHTML = '';
        (data.proposals || []).forEach(function (p) {
          var tr = buildRow(p);
          wireDropdown(tr, sheetId);
          tbody.appendChild(tr);
        });

        var visibleCount = (data.proposals || []).length;
        var hiddenCount = (data.hidden_count != null) ? data.hidden_count : 0;
        var totalLayers = (data.total_layers != null) ? data.total_layers : visibleCount;

        if (layerCountEl) layerCountEl.textContent = visibleCount + ' camadas';
        if (confirmedEl) confirmedEl.textContent = String(confirmedNames.size);
        if (totalVisEl) totalVisEl.textContent = String(visibleCount);

        // ---- hidden layers disclosure ----
        hiddenLayersData = data.hidden_layers || [];
        if (hiddenCount > 0) {
          if (totalCountEl) totalCountEl.textContent = String(totalLayers);
          if (hiddenCountEl) hiddenCountEl.textContent = String(hiddenCount);
          hiddenRow.style.display = '';
        }

        skeleton.style.display = 'none';
        loaded.style.display = '';
      } catch (err) {
        skeleton.style.display = 'none';
        errEl.style.display = '';
        errEl.textContent = 'Erro ao carregar camadas: ' + (err && err.message ? err.message : 'falha de rede');
      }
    }

    // ---- React to active sheet changes (reuses the existing row-activation system) ----
    // The Escala panel fires a custom event or we can watch for .is-active mutations.
    // Simplest: observe the sheet-list for class changes.
    function getActiveSheetId() {
      var active = document.querySelector('.sheet-row.is-active');
      return active ? active.getAttribute('data-sheet-id') : null;
    }

    var currentSheetId = null;
    function loadForActiveSheet() {
      var sid = getActiveSheetId();
      if (sid && sid !== currentSheetId) {
        currentSheetId = sid;
        confirmedNames = new Set();
        fetchLayers(sid);
      }
    }

    // Observe .sheet-row class changes (Escala JS adds/removes .is-active)
    var sheetList = document.querySelector('.sheet-list');
    if (sheetList) {
      var mo = new MutationObserver(function () { loadForActiveSheet(); });
      mo.observe(sheetList, { attributes: true, subtree: true, attributeFilter: ['class'] });
    }

    // Initial load
    loadForActiveSheet();

    // ---- Hidden-layers modal ----
    if (showHiddenBtn && modal) {
      showHiddenBtn.addEventListener('click', function () {
        // Populate hidden list
        if (hiddenList) {
          if (hiddenLayersData.length > 0) {
            hiddenList.innerHTML = hiddenLayersData.map(function (name) {
              return '<li style="padding: 4px 0; border-bottom: 1px solid var(--color-border-subtle); font-family: var(--font-mono); font-size: 12px; color: var(--color-fg-secondary);">' + name + '</li>';
            }).join('');
          } else {
            // Wave 2a coordination needed: the GET /layers response spec (as of Phase 8 handoff)
            // does not include a `hidden_layers: string[]` field — only `hidden_count: number`.
            // Until Wave 2a adds that field, the modal shows a count-only message.
            // To fix: add `hidden_layers: list[str]` to the Python container /extract/layers
            // response and mirror it in the API handler.
            var hc = (hiddenCountEl && hiddenCountEl.textContent) ? hiddenCountEl.textContent : '?';
            hiddenList.innerHTML = '<li style="color: var(--color-fg-muted); font-family: var(--font-sans); font-size: 13px; padding: var(--space-2) 0;">'
              + hc + ' camadas com prefixos não-elétrica (arquitetura, hidráulica, etc.) foram filtradas automaticamente. '
              + 'A lista detalhada de nomes estará disponível após a atualização da API.</li>';
          }
        }
        modal.showModal();
      });
    }
    if (modalClose && modal) {
      modalClose.addEventListener('click', function () { modal.close(); });
    }
    if (modal) {
      modal.addEventListener('click', function (e) {
        // Click on backdrop closes modal
        if (e.target === modal) modal.close();
      });
    }
  })();
</script>
