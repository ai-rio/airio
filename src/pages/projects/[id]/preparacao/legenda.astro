<script is:inline>
  // ===========================================
  // IIFE 1: Device row expand/collapse
  // ===========================================
  (function () {
    var rows = document.querySelectorAll('.device-row');
    rows.forEach(function (row) {
      var summary = row.querySelector('.device-row-summary');
      if (!summary) return;
      summary.addEventListener('click', function (e) {
        // ignore clicks on the inner quick-confirm button
        if (e.target.closest && e.target.closest('.quick-confirm')) return;
        var wasExpanded = row.classList.contains('is-expanded');
        rows.forEach(function (r) {
          r.classList.remove('is-expanded');
          var s = r.querySelector('.device-row-summary');
          if (s) s.setAttribute('aria-expanded', 'false');
        });
        if (!wasExpanded) {
          row.classList.add('is-expanded');
          summary.setAttribute('aria-expanded', 'true');
        }
      });
      summary.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          summary.click();
        }
      });
    });
  })();
</script>

<script is:inline>
  // ===========================================
  // IIFE 2: Quick-confirm toggle
  // ===========================================
  (function () {
    document.querySelectorAll('.quick-confirm').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var row = btn.closest('.device-row');
        var status = row && row.querySelector('.device-status');
        if (btn.classList.contains('is-confirmed')) {
          btn.classList.remove('is-confirmed');
          if (status) {
            status.classList.remove('is-confirmed');
            status.classList.add('is-pending');
            // lastChild is the text node after the dot span
            var textNode = status.lastChild;
            if (textNode) textNode.textContent = 'A confirmar';
          }
        } else {
          btn.classList.add('is-confirmed');
          if (status) {
            status.classList.remove('is-pending');
            status.classList.add('is-confirmed');
            var textNode = status.lastChild;
            if (textNode) textNode.textContent = 'Confirmado';
          }
        }
      });
    });
  })();
</script>

<script is:inline>
  // ===========================================
  // IIFE 3: Variant chip + negative chip remove
  // ===========================================
  (function () {
    document.querySelectorAll('.variant-chip .close, .negative-chip .close').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var chip = btn.closest('.variant-chip') || btn.closest('.negative-chip');
        if (chip) chip.remove();
      });
    });
  })();
</script>

<script is:inline>
  // ===========================================
  // IIFE 4: Bulk accept all
  // ===========================================
  (function () {
    var accept = document.querySelector('.meta-bar .bulk-btn');
    if (!accept) return;
    accept.addEventListener('click', function () {
      document.querySelectorAll('.quick-confirm').forEach(function (btn) {
        if (!btn.classList.contains('is-confirmed')) btn.click();
      });
      accept.textContent = '✓ Todos aceitos';
    });
  })();
</script>
